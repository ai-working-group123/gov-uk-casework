<div >
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold mb-2">Correspondences for Action: <%= @action.title %></h1>
    <%= link_to "New Correspondence", new_case_action_correspondence_path(@case, @action), class: "btn-secondary" %>
  </div>

  <% if @correspondences.any? %>
    <table class="gds-table">
      <thead>
        <tr>
          <th>Subject</th>
          <th>Channel</th>
          <th>Direction</th>
          <th>Sent</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @correspondences.each do |corr| %>
          <tr>
            <td><%= corr.subject %></td>
            <td><%= corr.channel.humanize %></td>
            <td><%= corr.direction.humanize %></td>
            <td><%= corr.sent_at&.strftime("%d %b %Y") || "\u2014" %></td>
            <td class="flex gap-3">
              <%= link_to "Show", case_action_correspondence_path(@case, @action, corr), class: "link" %>
              <%= link_to "Edit", edit_case_action_correspondence_path(@case, @action, corr), class: "link" %>
              <%= button_to "Delete", case_action_correspondence_path(@case, @action, corr), method: :delete, class: "link text-gds-red", data: { turbo_confirm: "Are you sure?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gds-dark-grey">No correspondences yet.</p>
  <% end %>

  <div class="mt-4">
    <%= link_to "Back to Action", case_action_path(@case, @action), class: "link" %>
  </div>
</div>
