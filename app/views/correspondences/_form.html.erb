<%= form_with(model: [@case, @action, correspondence]) do |form| %>
  <% if correspondence.errors.any? %>
    <div class="notification-error">
      <h2><%= pluralize(correspondence.errors.count, "error") %> prohibited this correspondence from being saved:</h2>
      <ul class="list-disc ml-5 mt-2">
        <% correspondence.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :channel, class: "form-label" %>
    <%= form.select :channel, Correspondence.channels.keys.map { |c| [c.humanize, c] }, {}, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :direction, class: "form-label" %>
    <%= form.select :direction, Correspondence.directions.keys.map { |d| [d.humanize, d] }, {}, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :subject, class: "form-label" %>
    <%= form.text_field :subject, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :body, class: "form-label" %>
    <%= form.text_area :body, rows: 5, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :policy_reference_id, "Policy Reference", class: "form-label" %>
    <%= form.collection_select :policy_reference_id, PolicyReference.all, :id, :title, { prompt: "None", include_blank: true }, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :policy_explanation, class: "form-label" %>
    <%= form.text_area :policy_explanation, rows: 3, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :guidance_url, class: "form-label" %>
    <%= form.url_field :guidance_url, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :sent_at, class: "form-label" %>
    <%= form.datetime_local_field :sent_at, class: "w-full" %>
  </div>

  <div>
    <%= form.submit class: "btn-primary cursor-pointer" %>
  </div>
<% end %>
