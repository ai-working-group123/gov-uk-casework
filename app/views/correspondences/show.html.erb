<div>
  <% if notice.present? %><div class="notification-success"><%= notice %></div><% end %>

  <h1 class="text-3xl font-bold mb-6"><%= @correspondence.subject %></h1>

  <dl class="summary-list">
    <dt>Channel</dt>
    <dd><%= @correspondence.channel.humanize %></dd>
    <dt>Direction</dt>
    <dd><%= @correspondence.direction.humanize %></dd>
    <dt>Body</dt>
    <dd class="whitespace-pre-wrap"><%= @correspondence.body %></dd>
    <dt>Policy Reference</dt>
    <dd><%= @correspondence.policy_reference&.title || "\u2014" %></dd>
    <dt>Policy Explanation</dt>
    <dd><%= @correspondence.policy_explanation || "\u2014" %></dd>
    <dt>Sent</dt>
    <dd><%= @correspondence.sent_at&.strftime("%d %b %Y %H:%M") || "\u2014" %></dd>
  </dl>

  <div class="flex gap-4">
    <%= link_to "Edit", edit_case_action_correspondence_path(@case, @action, @correspondence), class: "link" %>
    <%= link_to "Back to Correspondences", case_action_correspondences_path(@case, @action), class: "link-back" %>
  </div>
</div>
