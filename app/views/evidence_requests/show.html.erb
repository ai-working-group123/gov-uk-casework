<div>
  <% if notice.present? %><div class="notification-success"><%= notice %></div><% end %>

  <h1 class="text-3xl font-bold mb-6">Evidence Request</h1>

  <dl class="summary-list">
    <dt>Requested By</dt>
    <dd><%= @evidence_request.requested_by.name %></dd>
    <dt>Status</dt>
    <dd><%= @evidence_request.status.humanize %></dd>
    <dt>Deadline</dt>
    <dd><%= @evidence_request.deadline.strftime("%d %b %Y %H:%M") %></dd>
    <dt>Notify Via</dt>
    <dd><%= @evidence_request.notify_via %></dd>
    <dt>Cover Message</dt>
    <dd class="whitespace-pre-wrap"><%= @evidence_request.cover_message || "\u2014" %></dd>
    <dt>Sent</dt>
    <dd><%= @evidence_request.sent_at&.strftime("%d %b %Y %H:%M") || "\u2014" %></dd>
  </dl>

  <div class="flex gap-4 mb-8">
    <%= link_to "Edit", edit_case_evidence_request_path(@case, @evidence_request), class: "link" %>
    <%= link_to "Items", case_evidence_request_evidence_request_items_path(@case, @evidence_request), class: "link" %>
    <%= link_to "Back to Evidence Requests", case_evidence_requests_path(@case), class: "link-back" %>
  </div>
</div>
