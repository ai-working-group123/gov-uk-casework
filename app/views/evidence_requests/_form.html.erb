<%= form_with(model: [@case, evidence_request]) do |form| %>
  <% if evidence_request.errors.any? %>
    <div class="notification-error">
      <h2><%= pluralize(evidence_request.errors.count, "error") %> prohibited this evidence request from being saved:</h2>
      <ul class="list-disc ml-5 mt-2">
        <% evidence_request.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :requested_by_id, "Requested by", class: "form-label" %>
    <%= form.collection_select :requested_by_id, Caseworker.all, :id, :name, { prompt: "Select caseworker" }, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :status, class: "form-label" %>
    <%= form.select :status, EvidenceRequest.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :deadline, class: "form-label" %>
    <%= form.datetime_local_field :deadline, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :notify_via, class: "form-label" %>
    <%= form.number_field :notify_via, class: "w-full", min: 0, max: 7 %>
    <p class="form-hint">Bitmask: Email=1, Portal=2, SMS=4</p>
  </div>

  <div class="form-group">
    <%= form.label :cover_message, class: "form-label" %>
    <%= form.text_area :cover_message, rows: 4, class: "w-full" %>
  </div>

  <div>
    <%= form.submit class: "btn-primary cursor-pointer" %>
  </div>
<% end %>
