<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Case Management Service — Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Case Management Admin">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "marksmith" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gds-page-bg min-h-screen text-gds-black">
    <!-- GDS-style blue header -->
    <header class="bg-gds-blue">
      <div class="max-w-[960px] mx-auto px-4 py-3 flex items-baseline justify-between">
        <div class="flex items-baseline gap-4">
          <a href="<%= root_path %>" class="text-white font-bold text-lg no-underline hover:underline decoration-1">
            Case Management Service
          </a>
        </div>
        <nav class="flex items-center gap-6 text-sm">
          <%= link_to "Cases", cases_path, class: "text-white no-underline hover:underline" %>
          <%= link_to "Case Types", case_type_configs_path, class: "text-white no-underline hover:underline" %>
        </nav>
      </div>
    </header>

    <!-- Phase banner -->
    <div class="bg-gds-white border-b border-gds-mid-grey">
      <div class="max-w-[960px] mx-auto px-4 py-2 text-sm">
        <strong class="tag-blue mr-2">Beta</strong>
        <span class="text-gds-dark-grey">This is a new service – your feedback will help us improve it.</span>
      </div>
    </div>

    <% if flash[:notice] %>
      <div class="max-w-[960px] mx-auto px-4 mt-6">
        <div class="notification-success">
          <p><%= flash[:notice] %></p>
        </div>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div class="max-w-[960px] mx-auto px-4 mt-6">
        <div class="notification-error">
          <p><%= flash[:alert] %></p>
        </div>
      </div>
    <% end %>

    <main class="max-w-[960px] mx-auto px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
