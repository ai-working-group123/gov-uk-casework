<% content_for(:title) { "Review: #{@case_type_config.name} — Admin" } %>

<div>
  <!-- Header -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gds-black mb-1"><%= @case_type_config.name %></h1>
    <p class="text-gds-dark-grey mb-2"><%= @case_type_config.description %></p>
    <div class="flex items-center gap-4 text-sm text-gds-dark-grey">
      <span>SLA: <strong><%= @case_type_config.default_sla_days %> days</strong></span>
      <span>Organisation: <strong><%= @case_type_config.organisation || "Not set" %></strong></span>
      <span class="tag-yellow">Draft</span>
    </div>
  </div>

  <%= render "progress", current_step: 3 %>

  <%= form_with url: submit_review_case_type_config_path(@case_type_config), method: :post, data: { turbo: false, controller: "loading-form", action: "submit->loading-form#submit" } do %>

    <% sections = [
      { title: "Decision Tree", field: :decision_tree_md, param: "decision_tree_md" },
      { title: "State Transitions", field: :state_transitions_md, param: "state_transitions_md" },
      { title: "Evidence Requirements", field: :evidence_requirements_md, param: "evidence_requirements_md" },
      { title: "Risk Scoring", field: :risk_scoring_md, param: "risk_scoring_md" },
      { title: "Correspondence Templates", field: :correspondence_templates_md, param: "correspondence_templates_md" }
    ] %>

    <% sections.each do |section| %>
      <% content = @case_type_config.send(section[:field]) %>
      <% next if content.blank? %>

      <div class="gds-section" data-controller="markdown-section">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-bold text-gds-black"><%= section[:title] %></h2>
          <button
            type="button"
            data-action="markdown-section#toggleEdit"
            data-markdown-section-target="editBtn"
            class="link text-sm"
            aria-label="Edit <%= section[:title] %>"
          >
            Edit
          </button>
        </div>

        <div class="prose prose-sm max-w-none" data-markdown-section-target="preview">
          <%= marksmithed_sanitized(content) %>
        </div>

        <div class="hidden mt-4" data-markdown-section-target="editor">
          <%= marksmith_tag section[:param], value: content, class: "w-full" %>
          <div class="flex justify-end gap-3 mt-3">
            <button
              type="button"
              data-action="markdown-section#cancelEdit"
              class="btn-secondary text-sm px-3 py-1.5"
            >
              Cancel
            </button>
            <button
              type="button"
              data-action="markdown-section#saveEdit"
              class="btn-primary text-sm px-3 py-1.5"
            >
              Done editing
            </button>
          </div>
        </div>

        <input type="hidden" name="<%= section[:param] %>" value="<%= content %>" data-markdown-section-target="hiddenField">
      </div>
    <% end %>

    <div class="mt-8 pt-6 flex items-center justify-between" style="border-top: 1px solid var(--color-gds-mid-grey);">
      <p class="text-sm text-gds-dark-grey">
        Next: AI will review your configuration and suggest process improvements.
      </p>
      <button type="submit" class="btn-primary">
        Save &amp; Continue
        <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </button>
    </div>

  <% end %>

  <% if @case_type_config.source_metadata.present? %>
    <% metadata = @case_type_config.source_metadata.is_a?(String) ? JSON.parse(@case_type_config.source_metadata) : @case_type_config.source_metadata %>
    <div class="gds-section">
      <h2 class="text-sm font-bold text-gds-dark-grey uppercase tracking-wide mb-4">Source Information</h2>
      <dl class="summary-list">
        <% if metadata["urls"].present? %>
          <dt>Source URLs</dt>
          <dd>
            <% metadata["urls"].each do |url| %>
              <div><%= link_to url, url, target: "_blank", rel: "noopener noreferrer", class: "link break-all" %><span class="sr-only"> (opens in new tab)</span></div>
            <% end %>
          </dd>
        <% end %>
        <% if metadata["submitted_at"].present? %>
          <dt>Submitted</dt>
          <dd><%= metadata["submitted_at"] %></dd>
        <% end %>
      </dl>
    </div>
  <% end %>
</div>
