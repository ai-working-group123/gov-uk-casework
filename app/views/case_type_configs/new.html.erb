<% content_for(:title) { "Create New Case Type — Admin" } %>

<div class="max-w-[640px]">
  <h1 class="text-3xl font-bold text-gds-black mb-2">Create New Case Type</h1>
  <p class="text-gds-dark-grey mb-8">
    Describe the business process in plain English, or paste links to existing documentation.
    The more detail you provide, the better the generated configuration.
  </p>

  <%= form_with url: case_type_configs_path, method: :post, data: { controller: "url-list loading-form", turbo: false, action: "submit->loading-form#submit" } do |f| %>

    <div class="form-group">
      <label for="description" class="form-label">Description</label>
      <span class="form-hint">Optional if URLs are provided below</span>
      <textarea
        name="description"
        id="description"
        rows="6"
        class="w-full"
        placeholder="e.g. Residents can apply for an exemption to the 3 black bag limit if they have non-recyclable waste like pet litter or nappies. An officer reviews the application..."
      ></textarea>
    </div>

    <div class="form-group">
      <label class="form-label">Reference URLs</label>
      <span class="form-hint">Optional if description is provided above</span>
      <div data-url-list-target="container" class="space-y-2">
        <div class="flex gap-2" data-url-list-target="entry">
          <input
            type="url"
            name="urls[]"
            aria-label="Reference URL"
            class="flex-1"
            placeholder="https://www.gov.uk/..."
          >
        </div>
      </div>
      <button
        type="button"
        data-action="url-list#add"
        class="mt-2 link text-sm"
      >
        + Add another URL
      </button>
    </div>

    <div class="pt-6 mt-6" style="border-top: 1px solid var(--color-gds-mid-grey);">
      <button type="submit" class="btn-primary">
        Analyse &amp; Generate
        <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </button>
    </div>

  <% end %>
</div>
