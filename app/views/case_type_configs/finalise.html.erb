<% content_for(:title) { "Finalise: #{@case_type_config.name} — Admin" } %>

<div>
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gds-black mb-1"><%= @case_type_config.name %></h1>
    <p class="text-gds-dark-grey mb-2"><%= @case_type_config.description %></p>
    <div class="flex items-center gap-4 text-sm text-gds-dark-grey">
      <span>SLA: <strong><%= @case_type_config.default_sla_days %> days</strong></span>
      <span>Organisation: <strong><%= @case_type_config.organisation || "Not set" %></strong></span>
    </div>
  </div>

  <%= render "progress", current_step: 5 %>

  <% accepted = @case_type_config.case_type_suggestions.accepted %>
  <% if accepted.any? %>
    <div class="notification-success mb-6">
      <p class="mb-2"><%= accepted.count %> improvement<%= "s" if accepted.count > 1 %> applied</p>
      <ul class="text-sm text-gds-black list-disc list-inside space-y-1">
        <% accepted.each do |s| %>
          <li><%= s.title %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% sections = [
    { title: "Decision Tree", field: :decision_tree_md },
    { title: "State Transitions", field: :state_transitions_md },
    { title: "Evidence Requirements", field: :evidence_requirements_md },
    { title: "Risk Scoring", field: :risk_scoring_md },
    { title: "Correspondence Templates", field: :correspondence_templates_md }
  ] %>

  <% sections.each do |section| %>
    <% content = @case_type_config.send(section[:field]) %>
    <% next if content.blank? %>

    <div class="gds-section">
      <h2 class="text-xl font-bold text-gds-black mb-4"><%= section[:title] %></h2>
      <div class="prose prose-sm max-w-none">
        <%= marksmithed_sanitized(content) %>
      </div>
    </div>
  <% end %>

  <% if @case_type_config.source_metadata.present? %>
    <% metadata = @case_type_config.source_metadata.is_a?(String) ? JSON.parse(@case_type_config.source_metadata) : @case_type_config.source_metadata %>
    <div class="gds-section">
      <h2 class="text-sm font-bold text-gds-dark-grey uppercase tracking-wide mb-4">Source Information</h2>
      <dl class="summary-list">
        <% if metadata["urls"].present? %>
          <dt>Source URLs</dt>
          <dd>
            <% metadata["urls"].each do |url| %>
              <div><%= link_to url, url, target: "_blank", rel: "noopener noreferrer", class: "link break-all" %><span class="sr-only"> (opens in new tab)</span></div>
            <% end %>
          </dd>
        <% end %>
        <% if metadata["submitted_at"].present? %>
          <dt>Submitted</dt>
          <dd><%= metadata["submitted_at"] %></dd>
        <% end %>
      </dl>
    </div>
  <% end %>

  <div class="mt-8 pt-6 flex items-center justify-between border-t border-gds-mid-grey">
    <%= link_to "Back to Review", review_case_type_config_path(@case_type_config), class: "link-back" %>
    <div class="flex gap-3 items-center">
      <%= link_to "Save as Draft", case_type_configs_path, class: "btn-secondary" %>
      <%= button_to "Publish",
            publish_case_type_config_path(@case_type_config),
            method: :post,
            class: "btn-primary",
            data: { turbo: false } %>
    </div>
  </div>
</div>
