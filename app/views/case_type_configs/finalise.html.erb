<% content_for(:title) { "Finalise: #{@case_type_config.name} — Admin" } %>

<div class="max-w-6xl mx-auto">
  <!-- Header -->
  <div class="flex items-start justify-between mb-8">
    <div>
      <h2 class="text-2xl font-bold text-gray-900 mb-1"><%= @case_type_config.name %></h2>
      <p class="text-gray-600"><%= @case_type_config.description %></p>
      <div class="flex items-center gap-4 mt-2 text-sm text-gray-500">
        <span>SLA: <%= @case_type_config.default_sla_days %> days</span>
        <span>Organisation: <%= @case_type_config.organisation || "Not set" %></span>
      </div>
    </div>
  </div>

  <!-- Progress indicator -->
  <%= render "progress", current_step: 5 %>

  <!-- Applied suggestions summary -->
  <% accepted = @case_type_config.case_type_suggestions.accepted %>
  <% if accepted.any? %>
    <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
      <h3 class="text-sm font-semibold text-green-800 mb-2">
        ✅ <%= accepted.count %> improvement<%= "s" if accepted.count > 1 %> applied
      </h3>
      <ul class="text-sm text-green-700 list-disc list-inside space-y-1">
        <% accepted.each do |s| %>
          <li><%= s.title %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Final config sections (read-only) -->
  <div class="space-y-6">
    <% sections = [
      { title: "Decision Tree", field: :decision_tree_md, icon: "🌳" },
      { title: "State Transitions", field: :state_transitions_md, icon: "🔄" },
      { title: "Evidence Requirements", field: :evidence_requirements_md, icon: "📋" },
      { title: "Risk Scoring", field: :risk_scoring_md, icon: "⚠️" },
      { title: "Correspondence Templates", field: :correspondence_templates_md, icon: "✉️" }
    ] %>

    <% sections.each do |section| %>
      <% content = @case_type_config.send(section[:field]) %>
      <% next if content.blank? %>

      <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
        <div class="px-6 py-4 border-b border-gray-100">
          <h3 class="text-lg font-semibold text-gray-900">
            <span class="mr-2"><%= section[:icon] %></span><%= section[:title] %>
          </h3>
        </div>
        <div class="px-6 py-4 prose prose-sm max-w-none">
          <%== marksmithed(content) %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Source metadata -->
  <% if @case_type_config.source_metadata.present? %>
    <% metadata = @case_type_config.source_metadata.is_a?(String) ? JSON.parse(@case_type_config.source_metadata) : @case_type_config.source_metadata %>
    <div class="mt-8 bg-gray-50 border border-gray-200 rounded-lg p-6">
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Source Information</h3>
      <dl class="grid grid-cols-2 gap-4 text-sm">
        <% if metadata["urls"].present? %>
          <div>
            <dt class="text-gray-500">Source URLs</dt>
            <dd class="text-gray-900 mt-1">
              <% metadata["urls"].each do |url| %>
                <div><%= link_to url, url, target: "_blank", class: "text-blue-600 hover:underline break-all" %></div>
              <% end %>
            </dd>
          </div>
        <% end %>
        <% if metadata["submitted_at"].present? %>
          <div>
            <dt class="text-gray-500">Submitted</dt>
            <dd class="text-gray-900 mt-1"><%= metadata["submitted_at"] %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  <% end %>

  <!-- Action buttons -->
  <div class="mt-8 pt-6 border-t border-gray-200 flex items-center justify-between">
    <%= link_to "← Back to Review", review_case_type_config_path(@case_type_config),
          class: "text-sm text-gray-500 hover:text-gray-700" %>
    <div class="flex gap-3">
      <%= link_to "Save as Draft", case_type_configs_path,
            class: "border border-gray-300 text-gray-700 hover:bg-gray-50 font-semibold px-6 py-3 rounded-lg text-sm transition-colors" %>
      <%= button_to "Publish",
            publish_case_type_config_path(@case_type_config),
            method: :post,
            class: "bg-green-600 hover:bg-green-700 text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors inline-flex items-center gap-2",
            data: { turbo: false } %>
    </div>
  </div>
</div>
