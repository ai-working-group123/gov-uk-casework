<% content_for(:title) { "Edit: #{@case_type_config.name} — Admin" } %>

<div class="max-w-[640px]">
  <div class="mb-6">
    <%= link_to "Back to Case Types", case_type_configs_path, class: "link-back" %>
  </div>

  <%= render "progress", current_step: 1 %>

  <h1 class="text-3xl font-bold text-gds-black mb-2">Edit Case Type Source</h1>
  <p class="text-gds-dark-grey mb-8">
    Update the description or reference URLs, then re-analyse.
    The more detail you provide, the better the generated configuration.
  </p>

  <% metadata = @case_type_config.source_metadata || {} %>
  <% metadata = metadata.is_a?(String) ? JSON.parse(metadata) : metadata %>

  <%= form_with url: case_type_config_path(@case_type_config), method: :patch, data: { controller: "url-list loading-form", turbo: false, action: "submit->loading-form#submit" } do |f| %>

    <div class="form-group">
      <label for="description" class="form-label">Description</label>
      <span class="form-hint">Optional if URLs are provided below</span>
      <textarea
        name="description"
        id="description"
        rows="6"
        class="w-full"
        placeholder="e.g. Residents can apply for an exemption to the 3 black bag limit..."
      ><%= metadata["description"] || @case_type_config.description %></textarea>
    </div>

    <div class="form-group">
      <label class="form-label">Reference URLs</label>
      <span class="form-hint">Optional if description is provided above</span>
      <% urls = (metadata["urls"] || []).reject(&:blank?) %>
      <div data-url-list-target="container" class="space-y-2">
        <% if urls.any? %>
          <% urls.each do |url| %>
            <div class="flex gap-2" data-url-list-target="entry">
              <input
                type="url"
                name="urls[]"
                value="<%= url %>"
                class="flex-1"
                placeholder="https://www.gov.uk/..."
              >
              <button
                type="button"
                data-action="url-list#remove"
                class="text-gds-red hover:text-gds-red-dark px-2 text-lg"
                title="Remove URL"
              >&times;</button>
            </div>
          <% end %>
        <% else %>
          <div class="flex gap-2" data-url-list-target="entry">
            <input
              type="url"
              name="urls[]"
              class="flex-1"
              placeholder="https://www.gov.uk/..."
            >
          </div>
        <% end %>
      </div>
      <button
        type="button"
        data-action="url-list#add"
        class="mt-2 link text-sm"
      >
        + Add another URL
      </button>
    </div>

    <div class="pt-6 mt-6" style="border-top: 1px solid var(--color-gds-mid-grey);">
      <button type="submit" class="btn-primary">
        Re-analyse &amp; Generate
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </button>
    </div>

  <% end %>
</div>
