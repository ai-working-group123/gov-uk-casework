<% content_for(:title) { "Case Types — Admin" } %>

<div>
  <div class="flex items-start justify-between mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gds-black mb-1">Case Types</h1>
      <p class="text-gds-dark-grey text-base">Manage AI-generated case type configurations</p>
    </div>
    <%= link_to new_case_type_config_path, class: "btn-primary" do %>
      New Case Type
    <% end %>
  </div>

  <% if @case_type_configs.any? %>
    <table class="gds-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Organisation</th>
          <th>Status</th>
          <th>Created</th>
        </tr>
      </thead>
      <tbody>
        <% @case_type_configs.each do |config| %>
          <tr>
            <td>
              <%= link_to config.name, case_type_config_path(config), class: "link font-semibold" %>
              <% if config.description.present? %>
                <p class="text-sm text-gds-dark-grey mt-0.5"><%= config.description.truncate(120) %></p>
              <% end %>
            </td>
            <td class="text-sm"><%= config.organisation %></td>
            <td>
              <span class="<%= case config.status
                  when 'published' then 'tag-green'
                  when 'archived' then 'tag-grey'
                  else 'tag-yellow'
                  end %>">
                <%= config.status.upcase %>
              </span>
            </td>
            <td class="text-sm text-gds-dark-grey"><%= time_ago_in_words(config.created_at) %> ago</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="py-12 border-t-3 border-gds-blue">
      <h2 class="text-xl font-bold mb-2">No case types yet</h2>
      <p class="text-gds-dark-grey mb-4">Case types define the rules, evidence requirements, and decision trees for different application types. Create your first one to get started.</p>
      <%= link_to "Create your first case type", new_case_type_config_path, class: "btn-primary" %>
    </div>
  <% end %>
</div>
