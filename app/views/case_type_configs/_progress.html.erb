<%# Render the step progress bar. Pass current_step: 1..5 %>
<% steps = [
  { label: "Source", path: edit_case_type_config_path(@case_type_config) },
  { label: "Clarify", path: questions_case_type_config_path(@case_type_config) },
  { label: "Review", path: review_case_type_config_path(@case_type_config) },
  { label: "Suggestions", path: suggestions_case_type_config_path(@case_type_config) },
  { label: "Finalise", path: finalise_case_type_config_path(@case_type_config) }
] %>

<nav class="mb-10" aria-label="Progress" data-controller="step-navigation">
  <ol class="flex items-center gap-0 text-sm">
    <% steps.each_with_index do |step, index| %>
      <% step_num = index + 1 %>
      <li class="flex items-center">
        <% if step_num < current_step %>
          <%= link_to step[:path], class: "flex items-center gap-1.5 text-gds-green font-semibold hover:underline" do %>
            <span class="inline-flex items-center justify-center w-6 h-6 bg-gds-green text-white text-xs font-bold" aria-hidden="true">✓</span>
            <span><%= step[:label] %><span class="sr-only"> (completed)</span></span>
          <% end %>
        <% elsif step_num == current_step %>
          <span class="flex items-center gap-1.5 font-bold text-gds-black" aria-current="step">
            <span class="inline-flex items-center justify-center w-6 h-6 bg-gds-blue text-white text-xs font-bold" aria-hidden="true"><%= step_num %></span>
            <span><%= step[:label] %></span>
          </span>
        <% else %>
          <%= link_to step[:path], class: "flex items-center gap-1.5 text-gds-mid-grey hover:text-gds-dark-grey", data: { step_navigation_target: "futureLink" } do %>
            <span class="inline-flex items-center justify-center w-6 h-6 border-2 border-gds-mid-grey text-gds-mid-grey text-xs font-bold" aria-hidden="true"><%= step_num %></span>
            <span><%= step[:label] %></span>
          <% end %>
        <% end %>
        <% if index < steps.length - 1 %>
          <span class="mx-3 w-8 h-0.5 <%= step_num < current_step ? 'bg-gds-green' : 'bg-gds-mid-grey' %>" aria-hidden="true"></span>
        <% end %>
      </li>
    <% end %>
  </ol>
</nav>
