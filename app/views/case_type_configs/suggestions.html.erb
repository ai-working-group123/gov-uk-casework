<% content_for(:title) { "Process Improvement Suggestions — Admin" } %>

<div>
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gds-black mb-1"><%= @case_type_config.name %></h1>
    <p class="text-gds-dark-grey mb-2">
      The AI has reviewed your configuration and identified potential improvements.
      Accept the ones you'd like applied, or reject them to keep the current configuration.
    </p>
  </div>

  <%= render "progress", current_step: 4 %>

  <%= form_with url: apply_suggestions_case_type_config_path(@case_type_config), method: :post, data: { turbo: false, controller: "loading-form", action: "submit->loading-form#submit" } do %>

    <% @suggestions.each do |suggestion| %>
      <div class="gds-section" data-controller="suggestion">
        <div class="flex items-start gap-4">
          <div class="pt-0.5">
            <input
              type="checkbox"
              name="suggestions[<%= suggestion.id %>][accepted]"
              value="1"
              id="suggestion_<%= suggestion.id %>"
              class="w-5 h-5"
              <%= "checked" unless suggestion.rejected? %>
              data-action="change->suggestion#toggle"
              data-suggestion-target="checkbox"
            >
          </div>

          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <h2 class="text-base font-bold text-gds-black">
                <label for="suggestion_<%= suggestion.id %>" class="cursor-pointer"><%= suggestion.title %></label>
              </h2>
              <span class="<%= case suggestion.priority
                  when 'high' then 'tag-red'
                  when 'medium' then 'tag-yellow'
                  else 'tag-grey'
                  end %>">
                <%= suggestion.priority.upcase %>
              </span>
              <span class="tag-grey"><%= suggestion.category %></span>
            </div>

            <p class="text-sm text-gds-black mb-2"><%= suggestion.description %></p>

            <% if suggestion.impact_description.present? %>
              <p class="text-sm text-gds-dark-grey mb-2">
                <strong>Impact:</strong> <%= suggestion.impact_description %>
              </p>
            <% end %>

            <% if suggestion.standard_reference.present? %>
              <p class="text-xs text-gds-dark-grey">
                Ref: <%= suggestion.standard_reference %>
              </p>
            <% end %>

            <div class="form-group mt-3 mb-0" data-suggestion-target="commentArea">
              <label class="form-label text-xs">Additional comments (optional)</label>
              <input
                type="text"
                name="suggestions[<%= suggestion.id %>][comment]"
                class="w-full"
                placeholder="e.g. Apply this but with a 21-day window instead of 14..."
              >
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if @suggestions.empty? %>
      <div class="inset-text">
        <p class="text-gds-dark-grey">No improvement suggestions were generated. Your configuration looks good.</p>
      </div>
    <% end %>

    <div class="mt-8 pt-6 flex items-center justify-between" style="border-top: 1px solid var(--color-gds-mid-grey);">
      <p class="text-sm text-gds-dark-grey">
        Accepted suggestions will be applied by AI. You'll review the final result next.
      </p>
      <div class="flex gap-3 items-center">
        <%= link_to "Skip suggestions", finalise_case_type_config_path(@case_type_config), class: "link text-sm" %>
        <button type="submit" class="btn-primary">
          Apply &amp; Continue
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </button>
      </div>
    </div>

  <% end %>
</div>
