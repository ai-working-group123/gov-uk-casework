<% content_for(:title) { "Process Improvement Suggestions — Admin" } %>

<div class="max-w-4xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-1"><%= @case_type_config.name %></h2>
    <p class="text-gray-600 mb-2">
      The AI has reviewed your configuration and identified potential improvements.
      Accept the ones you'd like applied, or reject them to keep the current configuration.
    </p>
  </div>

  <!-- Progress indicator -->
  <%= render "progress", current_step: 4 %>

  <%= form_with url: apply_suggestions_case_type_config_path(@case_type_config), method: :post, data: { turbo: false, controller: "loading-form", action: "submit->loading-form#submit" } do %>

    <div class="space-y-4">
      <% @suggestions.each do |suggestion| %>
        <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6" data-controller="suggestion">
          <div class="flex items-start gap-4">
            <!-- Checkbox -->
            <div class="pt-0.5">
              <input
                type="checkbox"
                name="suggestions[<%= suggestion.id %>][accepted]"
                value="1"
                id="suggestion_<%= suggestion.id %>"
                class="w-5 h-5 rounded text-blue-600 border-gray-300 focus:ring-blue-500"
                checked
                data-action="change->suggestion#toggle"
                data-suggestion-target="checkbox"
              >
            </div>

            <div class="flex-1">
              <!-- Title + priority badge -->
              <div class="flex items-center gap-2 mb-2">
                <h3 class="text-base font-semibold text-gray-900">
                  <label for="suggestion_<%= suggestion.id %>" class="cursor-pointer"><%= suggestion.title %></label>
                </h3>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
                  <%= case suggestion.priority
                      when 'high' then 'bg-red-100 text-red-700'
                      when 'medium' then 'bg-yellow-100 text-yellow-700'
                      else 'bg-gray-100 text-gray-600'
                      end %>">
                  <%= suggestion.priority.capitalize %>
                </span>
                <span class="text-xs text-gray-400 px-2 py-0.5 rounded-full bg-gray-50 border border-gray-100">
                  <%= suggestion.category %>
                </span>
              </div>

              <!-- Description -->
              <p class="text-sm text-gray-700 mb-2"><%= suggestion.description %></p>

              <!-- Impact -->
              <% if suggestion.impact_description.present? %>
                <p class="text-sm text-gray-500 mb-2">
                  <span class="font-medium text-gray-600">Impact:</span> <%= suggestion.impact_description %>
                </p>
              <% end %>

              <!-- Standard reference -->
              <% if suggestion.standard_reference.present? %>
                <p class="text-xs text-gray-400">
                  📖 <%= suggestion.standard_reference %>
                </p>
              <% end %>

              <!-- Comment field -->
              <div class="mt-3" data-suggestion-target="commentArea">
                <label class="block text-xs text-gray-500 mb-1">Additional comments (optional):</label>
                <input
                  type="text"
                  name="suggestions[<%= suggestion.id %>][comment]"
                  class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  placeholder="e.g. Apply this but with a 21-day window instead of 14..."
                >
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if @suggestions.empty? %>
      <div class="bg-white border border-gray-200 rounded-lg p-8 text-center">
        <p class="text-gray-500">No improvement suggestions were generated. Your configuration looks good!</p>
      </div>
    <% end %>

    <!-- Submit -->
    <div class="mt-8 pt-6 border-t border-gray-200 flex items-center justify-between">
      <p class="text-sm text-gray-500">
        Accepted suggestions will be applied by AI. You'll review the final result next.
      </p>
      <div class="flex gap-3">
        <%= link_to "Skip suggestions", finalise_case_type_config_path(@case_type_config),
              class: "text-sm text-gray-500 hover:text-gray-700 px-4 py-3" %>
        <button
          type="submit"
          class="bg-blue-700 hover:bg-blue-800 text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors inline-flex items-center gap-2"
        >
          Apply &amp; Continue
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </button>
      </div>
    </div>

  <% end %>
</div>
