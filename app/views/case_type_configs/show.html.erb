<% content_for(:title) { "Edit: #{@case_type_config.name} — Admin" } %>

<div class="max-w-3xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to Case Types", case_type_configs_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <!-- Progress indicator -->
  <%= render "progress", current_step: 1 %>

  <h2 class="text-2xl font-bold text-gray-900 mb-2">Edit Case Type Source</h2>
  <p class="text-gray-600 mb-8">
    Update the description or reference URLs, then re-analyse.
    The more detail you provide, the better the generated configuration.
  </p>

  <% metadata = @case_type_config.source_metadata || {} %>
  <% metadata = metadata.is_a?(String) ? JSON.parse(metadata) : metadata %>

  <%= form_with url: case_type_config_path(@case_type_config), method: :patch, class: "space-y-6", data: { controller: "url-list loading-form", turbo: false, action: "submit->loading-form#submit" } do |f| %>

    <!-- Description -->
    <div>
      <label for="description" class="block text-sm font-semibold text-gray-700 mb-1">
        Description <span class="text-gray-400 font-normal">(optional if URLs provided)</span>
      </label>
      <textarea
        name="description"
        id="description"
        rows="6"
        class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-y"
        placeholder="e.g. Residents can apply for an exemption to the 3 black bag limit if they have non-recyclable waste like pet litter or nappies. An officer reviews the application..."
      ><%= metadata["description"] || @case_type_config.description %></textarea>
    </div>

    <!-- Reference URLs -->
    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1">
        Reference URLs <span class="text-gray-400 font-normal">(optional if description provided)</span>
      </label>
      <% urls = (metadata["urls"] || []).reject(&:blank?) %>
      <div data-url-list-target="container" class="space-y-2">
        <% if urls.any? %>
          <% urls.each do |url| %>
            <div class="flex gap-2" data-url-list-target="entry">
              <input
                type="url"
                name="urls[]"
                value="<%= url %>"
                aria-label="Reference URL"
                class="flex-1 border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="https://www.gov.uk/..."
              >
              <button
                type="button"
                data-action="url-list#remove"
                class="text-red-400 hover:text-red-600 px-2 text-lg transition-colors"
                aria-label="Remove URL"
              ><span aria-hidden="true">&times;</span></button>
            </div>
          <% end %>
        <% else %>
          <div class="flex gap-2" data-url-list-target="entry">
            <input
              type="url"
              name="urls[]"
              aria-label="Reference URL"
              class="flex-1 border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              placeholder="https://www.gov.uk/..."
            >
          </div>
        <% end %>
      </div>
      <button
        type="button"
        data-action="url-list#add"
        class="mt-2 text-sm text-blue-600 hover:text-blue-800 font-medium inline-flex items-center gap-1"
      >
        <span aria-hidden="true" class="text-lg leading-none">+</span> Add another URL
      </button>
    </div>

    <!-- Submit -->
    <div class="pt-4 border-t border-gray-200">
      <button
        type="submit"
        class="bg-blue-700 hover:bg-blue-800 text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors inline-flex items-center gap-2"
      >
        Re-analyse &amp; Generate
        <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </button>
    </div>

  <% end %>
</div>
