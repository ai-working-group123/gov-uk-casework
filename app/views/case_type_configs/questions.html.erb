<% content_for(:title) { "Clarifying Questions — Admin" } %>

<div class="max-w-[640px]" data-controller="questions">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gds-black mb-2">Clarifying Questions</h1>
    <p class="text-gds-dark-grey">
      We've analysed the source material but need a few more details to generate the best configuration.
      Answer each question or skip if unsure.
    </p>
  </div>

  <%= render "progress", current_step: 2 %>

  <% first_unanswered = @questions.index { |q| !@saved_answers.key?(q[:id].to_s) } || 0 %>

  <%= form_with url: answer_case_type_config_path(@case_type_config), method: :post, data: { turbo: false, controller: "loading-form", action: "submit->loading-form#submit" } do |f| %>

    <% @questions.each_with_index do |question, index| %>
      <% qid = question[:id].to_s %>
      <% saved = @saved_answers[qid] %>
      <% is_answered = saved.present? %>
      <div
        class="mb-6 pb-6 question-card"
        data-questions-target="card"
        data-index="<%= index %>"
        data-answered="<%= is_answered %>"
        style="border-bottom: 1px solid var(--color-gds-mid-grey); <%= 'display: none;' unless index == first_unanswered %>"
      >
        <div class="flex items-start justify-between mb-4">
          <h2 class="text-xl font-bold text-gds-black">
            Question <%= index + 1 %> of <%= @questions.length %>
          </h2>
          <% if is_answered %>
            <span class="tag-green">Answered</span>
          <% end %>
        </div>

        <p class="text-gds-black mb-6 text-base"><%= question[:text] %></p>

        <input type="hidden" name="answers[<%= question[:id] %>][question]" value="<%= question[:text] %>">

        <fieldset class="space-y-3 mb-4">
          <% question[:suggested_answers].each_with_index do |answer, ai| %>
            <label class="flex items-start gap-3 p-3 cursor-pointer hover:bg-gds-light-grey transition-colors" style="border: 2px solid var(--color-gds-mid-grey); <%= saved && saved['selected'] == answer ? "border-color: var(--color-gds-blue); background: #e8f0fe;" : "" %>">
              <input
                type="radio"
                name="answers[<%= question[:id] %>][selected]"
                value="<%= answer %>"
                class="mt-0.5"
                data-action="change->questions#selectAnswer"
                <%= "checked" if saved && saved["selected"] == answer %>
              >
              <span class="text-sm text-gds-black"><%= answer %></span>
            </label>
          <% end %>
        </fieldset>

        <div class="form-group mb-4">
          <label class="form-label text-sm">Or provide your own answer:</label>
          <input
            type="text"
            name="answers[<%= question[:id] %>][custom]"
            value="<%= saved&.dig("custom") %>"
            class="w-full"
            placeholder="Type your answer..."
            data-action="input->questions#customAnswer"
          >
        </div>

        <div class="flex items-center justify-between pt-4">
          <label class="flex items-center gap-2 text-sm text-gds-dark-grey cursor-pointer">
            <input
              type="checkbox"
              name="answers[<%= question[:id] %>][skip]"
              value="1"
              data-action="change->questions#skipAnswer"
              <%= "checked" if saved && saved["skip"] == "1" %>
            >
            I don't know — use your best judgement
          </label>

          <div class="flex gap-2">
            <% if index > 0 %>
              <button
                type="button"
                data-action="questions#prev"
                class="btn-secondary text-sm px-3 py-2"
              >
                Previous
              </button>
            <% end %>
            <% if index < @questions.length - 1 %>
              <button
                type="button"
                data-action="questions#next"
                class="btn-primary text-sm px-3 py-2"
              >
                Next
              </button>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <div data-questions-target="submitArea" class="pt-4" style="<%= 'display: none;' if first_unanswered < @questions.length - 1 %>">
      <button type="submit" class="btn-primary">
        Generate Configuration
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </button>
      <p class="text-sm text-gds-dark-grey mt-2">
        This will generate the complete case type configuration. It may take a moment.
      </p>
    </div>
  <% end %>
</div>
