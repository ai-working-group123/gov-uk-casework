<%# Screen 7: Document Upload Page %>

<% reference = params[:reference] || "HO-T2-A3F9" %>

<% content_for :back_link do %>
  <a href="/lookup/<%= reference %>?action_required=true" class="govuk-back-link">Back</a>
<% end %>

<h1 class="govuk-heading-l">Upload document</h1>
<p class="govuk-body"><strong>Document:</strong> Sponsorship certificate</p>
<p class="govuk-body"><strong>Application:</strong> <%= reference %></p>

<p class="govuk-body">Upload a copy of your Certificate of Sponsorship.</p>

<ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-6">
  <li>a PDF, JPG, or PNG</li>
  <li>smaller than 10MB</li>
  <li>a clear, readable scan or photograph</li>
</ul>

<form action="/lookup/<%= reference %>/upload/<%= params[:item_id] %>" method="post" enctype="multipart/form-data">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

  <div class="govuk-form-group">
    <label class="govuk-label" for="document">
      Upload a file
    </label>
    <input class="govuk-file-upload" id="document" name="document" type="file" accept=".pdf,.jpg,.jpeg,.png">
  </div>

  <div class="govuk-form-group">
    <label class="govuk-label" for="note">
      Is there anything else you want to tell us about this document?
    </label>
    <div id="note-hint" class="govuk-hint">Optional</div>
    <textarea class="govuk-textarea" id="note" name="note" rows="3" aria-describedby="note-hint"></textarea>
  </div>

  <button type="submit" class="govuk-button" data-module="govuk-button">
    Upload document
  </button>
</form>

<%# Success state — static wireframe preview %>
<div class="govuk-panel govuk-panel--confirmation govuk-!-margin-top-6">
  <h1 class="govuk-panel__title">Document uploaded successfully</h1>
  <div class="govuk-panel__body">Reference: <%= reference %></div>
</div>
<p class="govuk-body-s govuk-!-color-secondary">(Success panel shown for wireframe — will only appear after upload in production)</p>

<p class="govuk-body govuk-!-margin-top-4">
  <a href="/lookup/<%= reference %>?action_required=true" class="govuk-link">Return to your application status</a>
</p>
