<% document_name = @evidence_item ? @evidence_item.evidence.evidence_type.humanize : "Document" %>
<% content_for :title, "Upload #{document_name.downcase}" %>

<% content_for :back_link do %>
  <%= link_to "Back", public_lookup_case_path(reference: @case.reference), class: "govuk-back-link" %>
<% end %>

<h1 class="govuk-heading-l">Upload document</h1>

<dl class="govuk-summary-list govuk-summary-list--no-border govuk-!-margin-bottom-6">
  <div class="govuk-summary-list__row">
    <dt class="govuk-summary-list__key">Document needed</dt>
    <dd class="govuk-summary-list__value govuk-!-font-weight-bold"><%= document_name %></dd>
  </div>
  <div class="govuk-summary-list__row">
    <dt class="govuk-summary-list__key">Application reference</dt>
    <dd class="govuk-summary-list__value"><%= @case.reference %></dd>
  </div>
</dl>

<% if @evidence_item&.reason.present? %>
  <div class="govuk-inset-text">
    <%= @evidence_item.reason %>
  </div>
<% end %>

<p class="govuk-body">You can upload:</p>
<ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-6">
  <li>a PDF, JPG, or PNG file</li>
  <li>a file smaller than 10MB</li>
  <li>a clear, readable scan or photograph</li>
</ul>

<%= form_tag public_lookup_upload_path(reference: @case.reference, item_id: params[:item_id]),
             method: :post, multipart: true do %>

  <div class="govuk-form-group">
    <label class="govuk-label govuk-label--m" for="document">
      Upload <%= document_name.downcase %>
    </label>
    <input class="govuk-file-upload" id="document" name="document" type="file" accept=".pdf,.jpg,.jpeg,.png">
  </div>

  <div class="govuk-form-group">
    <label class="govuk-label" for="note">
      Is there anything else you want to tell us about this document?
    </label>
    <div id="note-hint" class="govuk-hint">Optional</div>
    <textarea class="govuk-textarea" id="note" name="note" rows="3" aria-describedby="note-hint"></textarea>
  </div>

  <button type="submit" class="govuk-button" data-module="govuk-button">
    Upload document
  </button>
<% end %>

<p class="govuk-body">
  <%= link_to "Cancel and return to your application", public_lookup_case_path(reference: @case.reference), class: "govuk-link" %>
</p>
