<%# Screen 4b (passive) + Screen 6 (action required) — Applicant Status Page %>
<%# Wireframe shows both states. Toggle via ?action_required=true in URL for demo. %>

<% action_required = params[:action_required] == "true" %>
<% reference = params[:reference] || "VIS-2024-00847" %>

<p class="text-sm text-gray-500 mb-1">
  <a href="/lookup" style="color:#1D70B8;" class="underline">← Check another application</a>
</p>

<h1 class="text-2xl font-bold text-gray-900 mb-1">Application <%= reference %></h1>
<p class="text-gray-600 mb-6">Tier 2 (General) Work Visa</p>

<%# Status panel %>
<% if action_required %>
  <div class="border-l-4 border-orange-500 bg-orange-50 p-4 mb-6">
    <p class="font-bold text-orange-800 text-lg mb-1">🟠 Action needed — we need documents from you</p>
    <p class="text-gray-700 text-sm">We need some additional documents before we can continue processing your application. Please provide them by <strong>30 April 2024</strong>.</p>
  </div>

  <%# What to provide %>
  <div class="border border-gray-200 rounded p-5 mb-6">
    <h2 class="font-bold text-gray-900 mb-4">What you need to provide</h2>

    <%# Item 1 — digital upload %>
    <div class="mb-6 pb-6 border-b border-gray-200">
      <p class="font-bold text-gray-900 mb-1">1. Sponsorship certificate</p>
      <p class="text-sm text-gray-600 mb-2">A valid Certificate of Sponsorship from a licensed sponsor.</p>
      <p class="text-sm text-gray-600 mb-2"><strong>How to submit:</strong> Upload a copy using the button below.</p>
      <p class="text-sm mb-3"><span class="bg-red-100 text-red-700 px-2 py-0.5 rounded text-xs font-semibold">❌ Not yet received</span></p>
      <a href="/lookup/<%= reference %>/upload/1"
         class="inline-block bg-green-600 hover:bg-green-700 text-white font-bold px-4 py-2 rounded text-sm">
        Upload document
      </a>
    </div>

    <%# Item 2 — physical post %>
    <div class="mb-4">
      <p class="font-bold text-gray-900 mb-1">2. Employer letter <span class="font-normal text-gray-500">(original document required)</span></p>
      <p class="text-sm text-gray-600 mb-2">Original signed letter from your employer confirming your role, salary, and start date.</p>
      <p class="text-sm text-gray-600 mb-3"><strong>How to submit:</strong> Post the original document to:</p>
      <div class="bg-gray-50 border border-gray-200 rounded p-4 text-sm mb-3 font-mono leading-relaxed">
        Visa Processing Centre<br>
        PO Box 1234<br>
        Sheffield<br>
        S1 2AB<br>
        <br>
        <span class="text-gray-500">Write your reference number (<strong><%= reference %></strong>) on the front of the envelope.</span>
      </div>
      <p class="text-sm"><span class="bg-red-100 text-red-700 px-2 py-0.5 rounded text-xs font-semibold">❌ Not yet received</span></p>
    </div>

    <div class="mt-4 pt-4 border-t border-gray-200">
      <p class="text-sm text-gray-700 font-semibold">Deadline: <span class="text-red-600">30 April 2024</span></p>
    </div>
  </div>

  <%# What if I can't provide? %>
  <details class="border border-gray-200 rounded p-4 mb-6 text-sm text-gray-700">
    <summary class="font-bold cursor-pointer">What happens if I cannot provide these documents?</summary>
    <p class="mt-3">If we do not receive all requested documents by the deadline, your application may be decided based on the evidence we already have.</p>
    <p class="mt-2">If you are having difficulty obtaining a document, contact us quoting your reference number.</p>
  </details>

<% else %>
  <div class="border-l-4 border-blue-500 bg-blue-50 p-4 mb-6">
    <p class="font-bold text-blue-900 text-lg mb-1">⏳ Awaiting evidence</p>
    <p class="text-gray-700 text-sm">We are waiting to receive some of the documents needed to process your application. You do not need to do anything — we have contacted the relevant party directly.</p>
  </div>
<% end %>

<%# Timeline %>
<h2 class="font-bold text-gray-900 mb-3">Timeline</h2>
<ol class="relative border-l-2 border-gray-300 ml-3 space-y-4 mb-6">
  <% if action_required %>
  <li class="pl-6">
    <span class="absolute -left-1.5 mt-1.5 w-3 h-3 rounded-full bg-orange-500"></span>
    <p class="text-sm font-semibold text-gray-900">16 Apr 2024</p>
    <p class="text-sm text-gray-600">We asked you to provide additional documents</p>
  </li>
  <% end %>
  <li class="pl-6">
    <span class="absolute -left-1.5 mt-1.5 w-3 h-3 rounded-full bg-gray-400"></span>
    <p class="text-sm font-semibold text-gray-900">15 Mar 2024</p>
    <p class="text-sm text-gray-600">Reminder sent for outstanding documents</p>
  </li>
  <li class="pl-6">
    <span class="absolute -left-1.5 mt-1.5 w-3 h-3 rounded-full bg-gray-400"></span>
    <p class="text-sm font-semibold text-gray-900">01 Mar 2024</p>
    <p class="text-sm text-gray-600">Your financial documents were reviewed</p>
  </li>
  <li class="pl-6">
    <span class="absolute -left-1.5 mt-1.5 w-3 h-3 rounded-full bg-gray-400"></span>
    <p class="text-sm font-semibold text-gray-900">14 Feb 2024</p>
    <p class="text-sm text-gray-600">Your application was assigned to a caseworker</p>
  </li>
  <li class="pl-6">
    <span class="absolute -left-1.5 mt-1.5 w-3 h-3 rounded-full bg-gray-400"></span>
    <p class="text-sm font-semibold text-gray-900">12 Feb 2024</p>
    <p class="text-sm text-gray-600">Application received</p>
  </li>
</ol>

<%# What happens next %>
<div class="bg-gray-50 border border-gray-200 rounded p-5 text-sm text-gray-700">
  <p class="font-bold text-gray-900 mb-1">What happens next</p>
  <p>Once we have received all required documents, your application will be reviewed. Most applications receive a decision within 8 weeks of all evidence being received.</p>
</div>
