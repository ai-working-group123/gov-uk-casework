<%# Screen 4b (passive) + Screen 6 (action required) — Applicant Status Page %>
<%# Toggle via ?action_required=true in URL for demo. %>

<% action_required = params[:action_required] == "true" %>
<% reference = params[:reference] || "HO-T2-A3F9" %>

<% content_for :back_link do %>
  <a href="/lookup" class="govuk-back-link">Back</a>
<% end %>

<h1 class="govuk-heading-l">Application <%= reference %></h1>
<p class="govuk-body govuk-!-color-secondary">Tier 2 (Skilled Worker) Visa</p>

<% if action_required %>
  <div class="govuk-warning-text">
    <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
    <strong class="govuk-warning-text__text">
      <span class="govuk-visually-hidden">Warning</span>
      You need to provide documents by <strong>30 April 2024</strong>
    </strong>
  </div>

  <h2 class="govuk-heading-m">What you need to provide</h2>

  <dl class="govuk-summary-list govuk-!-margin-bottom-7">
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">1. Sponsorship certificate</dt>
      <dd class="govuk-summary-list__value">
        <p class="govuk-body govuk-!-margin-bottom-1">A valid Certificate of Sponsorship from a licensed sponsor.</p>
        <p class="govuk-body govuk-!-margin-bottom-2"><strong>How to submit:</strong> Upload a copy using the link below.</p>
        <strong class="govuk-tag govuk-tag--red">Not yet received</strong>
      </dd>
      <dd class="govuk-summary-list__actions">
        <a class="govuk-link" href="/lookup/<%= reference %>/upload/1">Upload document</a>
      </dd>
    </div>

    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">2. Employer letter <span class="govuk-body-s govuk-!-color-secondary">(original required)</span></dt>
      <dd class="govuk-summary-list__value">
        <p class="govuk-body govuk-!-margin-bottom-1">Original signed letter from your employer confirming your role, salary, and start date.</p>
        <p class="govuk-body govuk-!-margin-bottom-1"><strong>How to submit:</strong> Post the original to:</p>
        <p class="govuk-body govuk-!-margin-bottom-2">
          Visa Processing Centre<br>
          PO Box 1234<br>
          Sheffield<br>
          S1 2AB
        </p>
        <p class="govuk-body govuk-!-margin-bottom-2">Write your reference number (<strong><%= reference %></strong>) on the envelope.</p>
        <strong class="govuk-tag govuk-tag--red">Not yet received</strong>
      </dd>
      <dd class="govuk-summary-list__actions"></dd>
    </div>
  </dl>

  <details class="govuk-details">
    <summary class="govuk-details__summary">
      <span class="govuk-details__summary-text">What happens if I cannot provide these documents?</span>
    </summary>
    <div class="govuk-details__text">
      <p class="govuk-body">If we do not receive all requested documents by the deadline, your application may be decided based on the evidence we already have.</p>
      <p class="govuk-body">If you are having difficulty obtaining a document, contact us quoting your reference number.</p>
    </div>
  </details>

<% else %>
  <div class="govuk-inset-text">
    <p class="govuk-body govuk-!-margin-bottom-0">We are waiting to receive some documents needed to process your application. You do not need to do anything right now — we have contacted the relevant party directly.</p>
  </div>
<% end %>

<h2 class="govuk-heading-m">Timeline</h2>

<ol class="govuk-list" style="border-left: 4px solid #b1b4b6; padding-left: 20px; margin-left: 8px;">
  <% if action_required %>
  <li style="margin-bottom: 16px; position: relative;">
    <div style="position: absolute; left: -28px; top: 4px; width: 12px; height: 12px; border-radius: 50%; background: #d4351c;"></div>
    <strong class="govuk-body govuk-!-font-weight-bold">16 April 2024</strong>
    <p class="govuk-body govuk-!-margin-bottom-0">We asked you to provide additional documents</p>
  </li>
  <% end %>
  <li style="margin-bottom: 16px; position: relative;">
    <div style="position: absolute; left: -28px; top: 4px; width: 12px; height: 12px; border-radius: 50%; background: #b1b4b6;"></div>
    <strong class="govuk-body govuk-!-font-weight-bold">15 March 2024</strong>
    <p class="govuk-body govuk-!-margin-bottom-0">Reminder sent for outstanding documents</p>
  </li>
  <li style="margin-bottom: 16px; position: relative;">
    <div style="position: absolute; left: -28px; top: 4px; width: 12px; height: 12px; border-radius: 50%; background: #b1b4b6;"></div>
    <strong class="govuk-body govuk-!-font-weight-bold">1 March 2024</strong>
    <p class="govuk-body govuk-!-margin-bottom-0">Your financial documents were reviewed</p>
  </li>
  <li style="margin-bottom: 16px; position: relative;">
    <div style="position: absolute; left: -28px; top: 4px; width: 12px; height: 12px; border-radius: 50%; background: #b1b4b6;"></div>
    <strong class="govuk-body govuk-!-font-weight-bold">14 February 2024</strong>
    <p class="govuk-body govuk-!-margin-bottom-0">Your application was assigned to a caseworker</p>
  </li>
  <li style="position: relative;">
    <div style="position: absolute; left: -28px; top: 4px; width: 12px; height: 12px; border-radius: 50%; background: #1d70b8;"></div>
    <strong class="govuk-body govuk-!-font-weight-bold">12 February 2024</strong>
    <p class="govuk-body govuk-!-margin-bottom-0">Application received</p>
  </li>
</ol>

<div class="govuk-inset-text govuk-!-margin-top-6">
  <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">What happens next</p>
  <p class="govuk-body govuk-!-margin-bottom-0">Once we have received all required documents, your application will be reviewed. Most applications receive a decision within 8 weeks of all evidence being received.</p>
</div>
