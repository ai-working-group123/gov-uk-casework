<% content_for :title, "Check your application status" %>

<h1 class="govuk-heading-xl">Check your application status</h1>
<p class="govuk-body-l">Enter your application reference number to see the current status of your case.</p>

<% if flash[:alert] %>
  <div class="govuk-error-summary" data-module="govuk-error-summary">
    <div role="alert">
      <h2 class="govuk-error-summary__title">There is a problem</h2>
      <div class="govuk-error-summary__body">
        <ul class="govuk-list govuk-error-summary__list">
          <li><%= flash[:alert] %></li>
        </ul>
      </div>
    </div>
  </div>
<% end %>

<%= form_tag public_lookup_path, method: :get, id: "lookup-form" do %>
  <div class="govuk-form-group">
    <label class="govuk-label govuk-label--m" for="reference">
      Application reference number
    </label>
    <div id="reference-hint" class="govuk-hint">
      For example, HO-T2-A3F9. You can find this on your acknowledgement letter or email.
    </div>
    <input class="govuk-input govuk-input--width-20" id="reference" name="reference"
           type="text" autocomplete="off" spellcheck="false"
           aria-describedby="reference-hint"
           value="<%= params[:reference] %>">
  </div>

  <button type="submit" class="govuk-button" data-module="govuk-button">
    Find application
  </button>
<% end %>

<script>
  document.getElementById('lookup-form').addEventListener('submit', function(e) {
    e.preventDefault();
    var ref = document.getElementById('reference').value.trim().toUpperCase();
    if (ref) {
      window.location.href = '<%= public_lookup_path %>/' + encodeURIComponent(ref);
    }
  });
</script>
