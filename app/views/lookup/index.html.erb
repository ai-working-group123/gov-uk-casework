<%# Screen 4a: Applicant Lookup Form %>

<h1 class="govuk-heading-xl">Check your visa application status</h1>
<p class="govuk-body">Enter your application reference number. You can find this on the confirmation email you received when you submitted your application.</p>

<form action="/lookup/HO-T2-A3F9" method="get">
  <div class="govuk-form-group">
    <label class="govuk-label govuk-label--m" for="reference">
      Application reference number
    </label>
    <div id="reference-hint" class="govuk-hint">
      For example, HO-T2-A3F9
    </div>
    <input class="govuk-input govuk-input--width-20" type="text" id="reference" name="reference"
           aria-describedby="reference-hint" spellcheck="false" autocomplete="off">
  </div>
  <button type="submit" class="govuk-button" data-module="govuk-button">
    Check status
  </button>
</form>
