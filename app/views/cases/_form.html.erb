<%= form_with(model: @case) do |form| %>
  <% if @case.errors.any? %>
    <div class="bg-red-50 text-red-500 px-4 py-3 rounded mb-4">
      <h2><%= pluralize(@case.errors.count, "error") %> prohibited this case from being saved:</h2>
      <ul class="list-disc ml-5 mt-2">
        <% @case.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :applicant_name, class: "block font-medium mb-1" %>
    <%= form.text_field :applicant_name, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :applicant_email, class: "block font-medium mb-1" %>
    <%= form.email_field :applicant_email, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :nationality, class: "block font-medium mb-1" %>
    <%= form.text_field :nationality, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :case_type, class: "block font-medium mb-1" %>
    <%= form.select :case_type, Case.case_types.keys.map { |t| [t.humanize, t] }, { prompt: "Select type" }, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :status, class: "block font-medium mb-1" %>
    <%= form.select :status, Case.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :priority, class: "block font-medium mb-1" %>
    <%= form.select :priority, Case.priorities.keys.map { |p| [p.humanize, p] }, {}, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :risk_score, class: "block font-medium mb-1" %>
    <%= form.number_field :risk_score, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :assigned_to_id, "Assigned to", class: "block font-medium mb-1" %>
    <%= form.collection_select :assigned_to_id, Caseworker.all, :id, :name, { prompt: "Unassigned", include_blank: true }, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :sla_deadline, class: "block font-medium mb-1" %>
    <%= form.datetime_local_field :sla_deadline, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div>
    <%= form.submit class: "bg-blue-600 text-white px-4 py-2 rounded cursor-pointer hover:bg-blue-700" %>
  </div>
<% end %>
