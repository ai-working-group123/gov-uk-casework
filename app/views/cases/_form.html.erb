<%= form_with(model: @case) do |form| %>
  <% if @case.errors.any? %>
    <div class="notification-error mb-6">
      <p><%= pluralize(@case.errors.count, "error") %> prohibited this case from being saved:</p>
      <ul class="list-disc ml-5 mt-2 text-sm">
        <% @case.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :applicant_name %>
    <%= form.text_field :applicant_name %>
  </div>

  <div class="form-group">
    <%= form.label :applicant_email %>
    <%= form.email_field :applicant_email %>
  </div>

  <div class="form-group">
    <%= form.label :nationality %>
    <%= form.text_field :nationality %>
  </div>

  <div class="form-group">
    <%= form.label :case_type_config_id, "Case Type" %>
    <%= form.collection_select :case_type_config_id, CaseTypeConfig.all, :id, :name, { prompt: "Select type" } %>
  </div>

  <div class="form-group">
    <%= form.label :status %>
    <%= form.select :status, Case.statuses.keys.map { |s| [s.humanize, s] }, {} %>
  </div>

  <div class="form-group">
    <%= form.label :priority %>
    <%= form.select :priority, Case.priorities.keys.map { |p| [p.humanize, p] }, {} %>
  </div>

  <div class="form-group">
    <%= form.label :risk_score %>
    <%= form.number_field :risk_score %>
  </div>

  <div class="form-group">
    <%= form.label :assigned_to_id, "Assigned to" %>
    <%= form.collection_select :assigned_to_id, Caseworker.all, :id, :name, { prompt: "Unassigned", include_blank: true } %>
  </div>

  <div class="form-group">
    <%= form.label :sla_deadline %>
    <%= form.datetime_local_field :sla_deadline %>
  </div>

  <div class="pt-6 mt-6" style="border-top: 1px solid var(--color-gds-mid-grey);">
    <%= form.submit class: "btn-primary cursor-pointer" %>
  </div>
<% end %>
