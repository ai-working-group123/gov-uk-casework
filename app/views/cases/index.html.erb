<div class="max-w-6xl mx-auto py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Cases</h1>
    <%= link_to "New Case", new_case_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
  </div>

  <% if @cases.any? %>
    <table class="min-w-full border">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left">Reference</th>
          <th class="px-4 py-2 text-left">Applicant</th>
          <th class="px-4 py-2 text-left">Type</th>
          <th class="px-4 py-2 text-left">Status</th>
          <th class="px-4 py-2 text-left">Priority</th>
          <th class="px-4 py-2 text-left">SLA Deadline</th>
          <th class="px-4 py-2 text-left">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @cases.each do |kase| %>
          <tr class="border-t">
            <td class="px-4 py-2"><%= kase.reference %></td>
            <td class="px-4 py-2"><%= kase.applicant_name %></td>
            <td class="px-4 py-2"><%= kase.case_type_config&.name || "Unassigned" %></td>
            <td class="px-4 py-2"><%= kase.status.humanize %></td>
            <td class="px-4 py-2"><%= kase.priority.humanize %></td>
            <td class="px-4 py-2"><%= kase.sla_deadline&.strftime("%d %b %Y") %></td>
            <td class="px-4 py-2 flex gap-2">
              <%= link_to "Show", kase, class: "text-blue-600 hover:underline" %>
              <%= link_to "Edit", edit_case_path(kase), class: "text-blue-600 hover:underline" %>
              <%= button_to "Delete", kase, method: :delete, class: "text-red-600 hover:underline", data: { turbo_confirm: "Are you sure?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-500">No cases yet.</p>
  <% end %>
</div>
