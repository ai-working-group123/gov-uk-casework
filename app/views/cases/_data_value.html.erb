<%# Recursive renderer for arbitrary case_data values.
     Locals: key (Symbol/String, optional), value (any), depth (Integer) %>
<% depth ||= 0 %>

<% if value.is_a?(Hash) %>
  <div class="<%= depth > 0 ? 'ml-4' : '' %> mb-4">
    <% if local_assigns[:key] %>
      <h<%= [3, 3 + depth].min + 1 %> class="text-sm font-semibold text-gds-dark-grey mb-2"><%= key.to_s.humanize %></h<%= [3, 3 + depth].min + 1 %>>
    <% end %>
    <div class="grid grid-cols-2 gap-x-8 gap-y-2 text-sm">
      <% value.each do |k, v| %>
        <% if v.is_a?(Hash) || v.is_a?(Array) %>
          <div class="col-span-2">
            <%= render partial: "cases/data_value", locals: { key: k, value: v, depth: depth + 1 } %>
          </div>
        <% else %>
          <div>
            <span class="font-semibold text-gds-dark-grey"><%= k.to_s.humanize %>:</span>
            <span><%= v %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

<% elsif value.is_a?(Array) %>
  <div class="<%= depth > 0 ? 'ml-4' : '' %> mb-4">
    <% if local_assigns[:key] %>
      <h<%= [3, 3 + depth].min + 1 %> class="text-sm font-semibold text-gds-dark-grey mb-2"><%= key.to_s.humanize %></h<%= [3, 3 + depth].min + 1 %>>
    <% end %>
    <% if value.first.is_a?(Hash) %>
      <% value.each_with_index do |item, i| %>
        <div class="mb-2">
          <div class="grid grid-cols-2 gap-x-8 gap-y-2 text-sm">
            <% item.each do |k, v| %>
              <% if v.is_a?(Hash) || v.is_a?(Array) %>
                <div class="col-span-2">
                  <%= render partial: "cases/data_value", locals: { key: k, value: v, depth: depth + 1 } %>
                </div>
              <% else %>
                <div>
                  <span class="font-semibold text-gds-dark-grey"><%= k.to_s.humanize %>:</span>
                  <span><%= v %></span>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <ul class="list-disc list-inside text-sm text-gds-dark-grey">
        <% value.each do |item| %>
          <li><%= item %></li>
        <% end %>
      </ul>
    <% end %>
  </div>

<% else %>
  <div class="mb-4">
    <% if local_assigns[:key] %>
      <span class="font-semibold text-gds-dark-grey text-sm"><%= key.to_s.humanize %>:</span>
    <% end %>
    <span class="text-sm text-gds-dark-grey"><%= value %></span>
  </div>
<% end %>
