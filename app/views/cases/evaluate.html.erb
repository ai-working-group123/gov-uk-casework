<div>
  <div class="mb-6">
    <%= link_to "Back to case", case_path(@case), class: "link-back" %>
  </div>

  <h1 class="text-3xl font-bold mb-6">Rules Engine Evaluation — Case <%= @case.reference %></h1>

  <% if @evaluation[:operations].empty? %>
    <div class="inset-text">
      <p class="text-gds-dark-grey">No operations recommended. The case appears to be in the correct state.</p>
    </div>
  <% else %>
    <p class="text-sm text-gds-dark-grey mb-4">
      <%= @evaluation[:operations].count { |op| op[:valid] } %> valid operation(s),
      <%= @evaluation[:operations].count { |op| !op[:valid] } %> rejected.
    </p>

    <div class="space-y-4 mb-8">
      <% @evaluation[:operations].each_with_index do |op, i| %>
        <div class="mb-4 pb-4" style="border-bottom: 1px solid var(--color-gds-mid-grey);">
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-sm">
              <%= op[:op].upcase %> <%= op[:model] %>
              <% if op[:id] %>#<%= op[:id] %><% end %>
            </span>
            <strong class="<%= op[:valid] ? 'tag-green' : 'tag-red' %>">
              <%= op[:valid] ? 'VALID' : 'REJECTED' %>
            </strong>
          </div>

          <% if op[:attrs].present? %>
            <table class="gds-table text-sm mb-2">
              <thead>
                <tr><th>Attribute</th><th>Value</th></tr>
              </thead>
              <tbody>
                <% op[:attrs].each do |attr, value| %>
                  <tr>
                    <td class="font-mono text-gds-dark-grey"><%= attr %></td>
                    <td><%= value %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% end %>

          <% if op[:errors].present? %>
            <div class="text-sm text-gds-red mt-1">
              <% op[:errors].each do |error| %>
                <p><%= error %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @evaluation[:operations].any? { |op| op[:valid] } %>
      <%= form_tag evaluate_case_path(@case), method: :post, class: "inline" do %>
        <%= hidden_field_tag :apply, "true" %>
        <%= submit_tag "Apply Valid Operations",
            class: "btn-primary cursor-pointer",
            data: { confirm: "This will apply all valid operations to the case. Continue?" } %>
      <% end %>
    <% end %>
  <% end %>

  <% if @evaluation[:metadata].present? %>
    <p class="mt-8 text-xs text-gds-mid-grey">
      Model: <%= @evaluation[:metadata][:model] %> |
      Tokens: <%= @evaluation[:metadata][:tokens_used] %> |
      Time: <%= @evaluation[:metadata][:elapsed] %>s
    </p>
  <% end %>
</div>
