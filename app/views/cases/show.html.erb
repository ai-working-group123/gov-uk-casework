<%= turbo_stream_from @case %>

<div class="max-w-5xl mx-auto py-8 w-full">
  <% if notice.present? %>
    <div class="notification-success"><p><%= notice %></p></div>
  <% end %>
  <% if alert.present? %>
    <div class="notification-error"><p><%= alert %></p></div>
  <% end %>

  <%= turbo_frame_tag "case_evaluation_banner" do %>
    <% if @case.evaluation_in_progress? %>
      <div class="inset-text mb-6" style="border-left-color: var(--color-gds-blue);">
        <p class="font-semibold text-sm text-gds-black">Rules engine evaluation in progress</p>
        <p class="text-sm text-gds-dark-grey">The case is being analysed against its case type rules. Actions may be updated shortly.</p>
      </div>
    <% end %>
  <% end %>

  <div class="mb-6">
    <%= link_to "Back to cases", cases_path, class: "link-back" %>
  </div>

  <%# ── Case Header ── %>
  <h1 class="text-3xl font-bold mb-2">Case <%= @case.reference %></h1>
  <p class="text-gds-dark-grey mb-6"><%= @case.case_type_config&.name || "Unassigned type" %></p>

  <dl class="summary-list mb-8">
    <dt>Applicant</dt>
    <dd><%= @case.applicant_name %></dd>

    <dt>Status</dt>
    <dd><%= status_badge(@case) %></dd>

    <dt>Priority</dt>
    <dd><%= priority_badge(@case) %></dd>

    <dt>Submitted</dt>
    <dd><%= @case.submitted_at&.strftime("%d %b %Y") || "—" %></dd>

    <dt>SLA deadline</dt>
    <dd>
      <%= @case.sla_deadline&.strftime("%d %b %Y") || "—" %>
      <% if days_overdue(@case) %>
        <strong class="tag-red ml-2"><%= days_overdue(@case) %> DAYS OVERDUE</strong>
      <% end %>
    </dd>

    <dt>Assigned to</dt>
    <dd><%= @case.assigned_to&.name || "Unassigned" %></dd>

    <dt>Assigned to</dt>
    <dd><%= @case.assigned_to&.name || "Unassigned" %></dd>

    <dt>Last evaluated</dt>
    <dd><%= @case.last_evaluated_at&.strftime("%d %b %Y %H:%M") || "Never" %></dd>
  </dl>

  <%# ── Case Data ── %>
  <% if @case.case_data.present? %>
    <div class="gds-section">
      <h2 class="gds-section-title">Case Data</h2>
      <% @case.case_data.deep_symbolize_keys.each do |key, value| %>
        <%= render partial: "cases/data_value", locals: { key: key, value: value, depth: 0 } %>
      <% end %>
    </div>
  <% end %>

  <%# ── What you need to do ── %>
  <% outstanding_actions = @case.actions.reject { |a| a.completed? || a.cancelled? } %>
  <div class="gds-section">
    <h2 class="gds-section-title">What you need to do</h2>

    <% if outstanding_actions.any? %>
      <div class="space-y-4">
        <% outstanding_actions.each do |action| %>
          <div class="flex items-start gap-3" style="border-bottom: 1px solid var(--color-gds-mid-grey); padding-bottom: 1rem;">
            <div class="flex-1">
              <p class="font-bold text-sm"><%= action.title %></p>
              <% if action.description.present? %>
                <p class="text-sm text-gds-dark-grey mt-1"><%= action.description %></p>
              <% end %>
              <% if action.due_date %>
                <p class="text-sm text-gds-dark-grey mt-1">
                  Due: <%= action.due_date.strftime("%d %b %Y") %>
                  <% if action.due_date < Time.current %>
                    <strong class="tag-red ml-1"><%= ((Time.current - action.due_date) / 1.day).to_i %> DAYS AGO</strong>
                  <% end %>
                </p>
              <% end %>
              <% if action.blocked_by.present? %>
                <p class="text-sm mt-1"><strong class="tag-orange">BLOCKED</strong> <%= action.blocked_by %></p>
              <% end %>
              <% if action.chase_evidence? %>
                <div class="mt-2 flex gap-2">
                  <%= link_to "Mark as received", "#", class: "btn-primary text-xs" %>
                  <%= link_to "Send reminder", "#", class: "btn-secondary text-xs" %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gds-dark-grey">No outstanding actions — you're all caught up.</p>
    <% end %>
  </div>

  <%# ── Evidence & Policy side by side ── %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">

    <%# Evidence Checklist %>
    <div class="gds-section">
      <h2 class="gds-section-title">Evidence</h2>

      <% if @case.evidences.any? %>
        <table class="gds-table">
          <thead>
            <tr>
              <th>Type</th>
              <th>Status</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            <% @case.evidences.each do |evidence| %>
              <tr>
                <td class="font-medium"><%= evidence.evidence_type.humanize %></td>
                <td>
                  <% tag_class = case evidence.status
                      when "accepted", "received" then "tag-green"
                      when "rejected" then "tag-red"
                      when "not_received" then "tag-orange"
                      when "under_review" then "tag-blue"
                      else "tag-grey"
                      end %>
                  <strong class="<%= tag_class %>"><%= evidence.status.humanize.upcase %></strong>
                  <% if evidence.status == "not_received" && evidence.required_by && evidence.required_by < Time.current %>
                    <br><span class="text-sm text-gds-red"><%= ((Time.current - evidence.required_by) / 1.day).to_i %> days late</span>
                  <% end %>
                </td>
                <td class="text-sm text-gds-dark-grey"><%= evidence.notes %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% received_count = @case.evidences.count { |e| %w[received accepted under_review].include?(e.status) } %>
        <p class="text-sm text-gds-dark-grey mt-3"><%= received_count %>/<%= @case.evidences.size %> received</p>
      <% else %>
        <p class="text-gds-dark-grey">Evidence requirements will appear here once the case type has been assigned and evaluated.</p>
      <% end %>
    </div>

    <%# Applicable Policy %>
    <div class="gds-section">
      <h2 class="gds-section-title">Applicable Policy</h2>

      <% policy_refs = @case.evidences.filter_map(&:policy_reference).uniq +
                        @case.actions.filter_map(&:policy_reference).uniq %>
      <% policy_refs = policy_refs.uniq %>

      <% if policy_refs.any? %>
        <% policy_refs.each do |policy| %>
          <div class="mb-4 pb-4" style="border-bottom: 1px solid var(--color-gds-mid-grey);">
            <p class="font-bold text-sm"><%= policy.title %></p>
            <p class="text-sm text-gds-dark-grey mt-1"><%= policy.summary %></p>

            <% if policy.criteria.present? %>
              <p class="text-sm font-semibold mt-2">Key criteria:</p>
              <ul class="list-disc list-inside text-sm text-gds-dark-grey mt-1">
                <% policy.criteria.split("\n").each do |criterion| %>
                  <% next if criterion.strip.blank? %>
                  <li><%= criterion.strip.sub(/\A[-•*]\s*/, "") %></li>
                <% end %>
              </ul>
            <% end %>

            <% if policy.govuk_url.present? %>
              <%= link_to "View full policy", policy.govuk_url, target: "_blank", class: "link text-sm mt-2 inline-block" %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="text-gds-dark-grey">No linked policy references.</p>
      <% end %>
    </div>
  </div>

  <%# ── Case Type Configuration ── %>
  <% if @case.case_type_config.present? %>
    <% config = @case.case_type_config %>
    <div class="gds-section">
      <h2 class="gds-section-title">Case Type: <%= config.name %></h2>

      <% if config.description.present? %>
        <p class="text-sm text-gds-dark-grey mb-4"><%= config.description %></p>
      <% end %>

      <dl class="summary-list mb-4">
        <dt>Organisation</dt>
        <dd><%= config.organisation || "—" %></dd>
        <dt>Default SLA</dt>
        <dd><%= config.default_sla_days ? "#{config.default_sla_days} days" : "—" %></dd>
        <dt>Status</dt>
        <dd class="capitalize"><%= config.status %></dd>
      </dl>

      <% [ ["Decision Tree", config.decision_tree_md],
           ["Evidence Requirements", config.evidence_requirements_md],
           ["State Transitions", config.state_transitions_md],
           ["Correspondence Templates", config.correspondence_templates_md],
           ["Risk Scoring", config.risk_scoring_md]
         ].each do |label, content| %>
        <% if content.present? %>
          <details class="gds-details mb-3">
            <summary><%= label %></summary>
            <pre class="text-sm text-gds-dark-grey mt-2 p-3 overflow-x-auto whitespace-pre-wrap" style="background: var(--color-gds-light-grey);"><%= content %></pre>
          </details>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# ── Case Timeline ── %>
  <div class="gds-section">
    <h2 class="gds-section-title">Case Timeline</h2>

    <% sorted_notes = @case.case_notes.sort_by(&:created_at).reverse %>
    <% if sorted_notes.any? %>
      <table class="gds-table">
        <thead>
          <tr>
            <th class="w-28">Date</th>
            <th class="w-28">Author</th>
            <th>Entry</th>
          </tr>
        </thead>
        <tbody>
          <% sorted_notes.each do |note| %>
            <tr>
              <td class="text-sm font-mono whitespace-nowrap"><%= note.created_at.strftime("%d %b %Y") %></td>
              <td class="text-sm"><%= timeline_author(note) %></td>
              <td class="text-sm"><%= timeline_icon(note) %> <%= note.content %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-gds-dark-grey">Timeline entries are added automatically as the case progresses. You can also add manual notes.</p>
    <% end %>

    <div class="mt-4">
      <%= link_to "Add note", new_case_case_note_path(@case), class: "btn-secondary" %>
    </div>
  </div>

  <%# ── Action links ── %>
  <div class="mt-8 flex gap-4">
    <%= link_to "Edit case", edit_case_path(@case), class: "link" %>
    <%= link_to "Evidence requests", case_evidence_requests_path(@case), class: "link" %>
    <%= button_to "Run Workflow", run_workflow_case_path(@case), method: :post, class: "bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700" %>
  </div>
</div>
