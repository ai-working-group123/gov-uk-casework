<div class="max-w-5xl mx-auto py-8 w-full">
  <% if notice.present? %>
    <p class="text-green-600 mb-4"><%= notice %></p>
  <% end %>

  <%# Back to dashboard link %>
  <div class="mb-6">
    <%= link_to "← Back to dashboard", cases_path, class: "text-blue-600 hover:underline text-sm" %>
  </div>

  <%# ── Case Header ── %>
  <div class="border border-gray-300 rounded p-6 mb-6">
    <h1 class="text-xl font-bold mb-4 border-b border-gray-200 pb-2">Case <%= @case.reference %></h1>

    <div class="grid grid-cols-2 gap-x-8 gap-y-3 text-sm">
      <div>
        <span class="font-semibold text-gray-700">Applicant:</span>
        <span><%= @case.applicant_name %></span>
      </div>
      <div>
        <span class="font-semibold text-gray-700">Status:</span>
        <%= status_badge(@case) %>
      </div>
      <div>
        <span class="font-semibold text-gray-700">Type:</span>
        <span><%= @case.case_type_config&.name || "Unassigned" %></span>
      </div>
      <div>
        <span class="font-semibold text-gray-700">Priority:</span>
        <%= priority_badge(@case) %>
      </div>
      <div>
        <span class="font-semibold text-gray-700">Submitted:</span>
        <span><%= @case.submitted_at&.strftime("%d %b %Y") %></span>
      </div>
      <div>
        <span class="font-semibold text-gray-700">SLA deadline:</span>
        <span><%= @case.sla_deadline&.strftime("%d %b %Y") %></span>
      </div>
      <div>
        <span class="font-semibold text-gray-700">Assigned to:</span>
        <span><%= @case.assigned_to&.name || "Unassigned" %></span>
      </div>
      <% if days_overdue(@case) %>
        <div>
          <span class="font-semibold text-gray-700">Days overdue:</span>
          <span class="text-red-600 font-bold"><%= days_overdue(@case) %></span>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── Case Data ── %>
  <% if @case.case_data.present? %>
    <div class="border border-gray-300 rounded p-6 mb-6">
      <h2 class="text-lg font-bold mb-4 border-b border-gray-200 pb-2">Case Data</h2>

      <% @case.case_data.deep_symbolize_keys.each do |key, value| %>
        <%= render partial: "cases/data_value", locals: { key: key, value: value, depth: 0 } %>
      <% end %>
    </div>
  <% end %>

  <%# ── What you need to do ── %>
  <% outstanding_actions = @case.actions.reject { |a| a.completed? || a.cancelled? } %>
  <div class="border border-gray-300 rounded p-6 mb-6">
    <h2 class="text-lg font-bold mb-4 border-b border-gray-200 pb-2">What you need to do</h2>

    <% if outstanding_actions.any? %>
      <div class="space-y-4">
        <% outstanding_actions.each do |action| %>
          <div class="flex items-start gap-3">
            <span class="text-lg"><%= action_priority_icon(action) %></span>
            <div class="flex-1">
              <p class="font-medium"><%= action.title %></p>
              <% if action.description.present? %>
                <p class="text-sm text-gray-600 mt-1"><%= action.description %></p>
              <% end %>
              <% if action.due_date %>
                <p class="text-xs text-gray-500 mt-1">
                  Due: <%= action.due_date.strftime("%d %b %Y") %>
                  <% if action.due_date < Time.current %>
                    <span class="text-red-600 font-semibold">(<%= ((Time.current - action.due_date) / 1.day).to_i %> days ago)</span>
                  <% end %>
                </p>
              <% end %>
              <% if action.blocked_by.present? %>
                <p class="text-xs text-yellow-700 mt-1">Blocked by: <%= action.blocked_by %></p>
              <% end %>
              <div class="mt-2 flex gap-2">
                <% if action.chase_evidence? %>
                  <%= link_to "Mark as received", "#", class: "text-xs bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700" %>
                  <%= link_to "Send reminder", "#", class: "text-xs bg-yellow-500 text-white px-3 py-1 rounded hover:bg-yellow-600" %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-sm">No outstanding actions — you're all caught up.</p>
    <% end %>
  </div>

  <%# ── Evidence & Policy side by side ── %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">

    <%# Evidence Checklist %>
    <div class="border border-gray-300 rounded p-6">
      <h2 class="text-lg font-bold mb-4 border-b border-gray-200 pb-2">Evidence</h2>

      <% if @case.evidences.any? %>
        <ul class="space-y-2">
          <% @case.evidences.each do |evidence| %>
            <li class="flex items-start gap-2 text-sm">
              <span><%= evidence_status_icon(evidence) %></span>
              <div>
                <span class="font-medium"><%= evidence.evidence_type.humanize %></span>
                <% if evidence.status == "not_received" %>
                  <% if evidence.required_by && evidence.required_by < Time.current %>
                    <span class="text-red-600 text-xs ml-1">⚠️ <%= ((Time.current - evidence.required_by) / 1.day).to_i %> days late</span>
                  <% end %>
                <% elsif evidence.status == "received" || evidence.status == "accepted" %>
                  <span class="text-green-600 text-xs ml-1">(valid)</span>
                <% end %>
                <% if evidence.notes.present? %>
                  <p class="text-xs text-gray-500 mt-0.5"><%= evidence.notes %></p>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
        <% received_count = @case.evidences.count { |e| %w[received accepted under_review].include?(e.status) } %>
        <p class="text-xs text-gray-500 mt-4 pt-2 border-t border-gray-200"><%= received_count %>/<%= @case.evidences.size %> received</p>
      <% else %>
        <p class="text-gray-500 text-sm">No evidence items recorded.</p>
      <% end %>
    </div>

    <%# Applicable Policy %>
    <div class="border border-gray-300 rounded p-6">
      <h2 class="text-lg font-bold mb-4 border-b border-gray-200 pb-2">Applicable Policy</h2>

      <% policy_refs = @case.evidences.filter_map(&:policy_reference).uniq +
                        @case.actions.filter_map(&:policy_reference).uniq %>
      <% policy_refs = policy_refs.uniq %>

      <% if policy_refs.any? %>
        <% policy_refs.each do |policy| %>
          <div class="mb-4">
            <p class="font-medium text-sm">📋 <%= policy.title %></p>
            <p class="text-xs text-gray-600 mt-1"><%= policy.summary %></p>

            <% if policy.criteria.present? %>
              <p class="text-xs font-semibold text-gray-700 mt-2">Key criteria:</p>
              <ul class="list-disc list-inside text-xs text-gray-600 mt-1">
                <% policy.criteria.split("\n").each do |criterion| %>
                  <% next if criterion.strip.blank? %>
                  <li><%= criterion.strip.sub(/\A[-•*]\s*/, "") %></li>
                <% end %>
              </ul>
            <% end %>

            <% if policy.govuk_url.present? %>
              <%= link_to "View full policy →", policy.govuk_url, target: "_blank", class: "text-blue-600 hover:underline text-xs mt-2 inline-block" %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="text-gray-500 text-sm">No linked policy references.</p>
      <% end %>
    </div>
  </div>

  <%# ── Case Type Configuration ── %>
  <% if @case.case_type_config.present? %>
    <% config = @case.case_type_config %>
    <div class="border border-gray-300 rounded p-6 mb-6">
      <h2 class="text-lg font-bold mb-4 border-b border-gray-200 pb-2">Case Type: <%= config.name %></h2>

      <% if config.description.present? %>
        <p class="text-sm text-gray-600 mb-4"><%= config.description %></p>
      <% end %>

      <div class="grid grid-cols-2 gap-x-8 gap-y-2 text-sm mb-4">
        <div>
          <span class="font-semibold text-gray-700">Organisation:</span>
          <span><%= config.organisation || "—" %></span>
        </div>
        <div>
          <span class="font-semibold text-gray-700">Default SLA:</span>
          <span><%= config.default_sla_days ? "#{config.default_sla_days} days" : "—" %></span>
        </div>
        <div>
          <span class="font-semibold text-gray-700">Status:</span>
          <span class="capitalize"><%= config.status %></span>
        </div>
      </div>

      <% if config.decision_tree_md.present? %>
        <details class="mb-3">
          <summary class="text-sm font-semibold text-gray-700 cursor-pointer hover:text-blue-600">Decision Tree</summary>
          <pre class="text-xs text-gray-600 mt-2 bg-gray-50 p-3 rounded overflow-x-auto whitespace-pre-wrap"><%= config.decision_tree_md %></pre>
        </details>
      <% end %>

      <% if config.evidence_requirements_md.present? %>
        <details class="mb-3">
          <summary class="text-sm font-semibold text-gray-700 cursor-pointer hover:text-blue-600">Evidence Requirements</summary>
          <pre class="text-xs text-gray-600 mt-2 bg-gray-50 p-3 rounded overflow-x-auto whitespace-pre-wrap"><%= config.evidence_requirements_md %></pre>
        </details>
      <% end %>

      <% if config.state_transitions_md.present? %>
        <details class="mb-3">
          <summary class="text-sm font-semibold text-gray-700 cursor-pointer hover:text-blue-600">State Transitions</summary>
          <pre class="text-xs text-gray-600 mt-2 bg-gray-50 p-3 rounded overflow-x-auto whitespace-pre-wrap"><%= config.state_transitions_md %></pre>
        </details>
      <% end %>

      <% if config.correspondence_templates_md.present? %>
        <details class="mb-3">
          <summary class="text-sm font-semibold text-gray-700 cursor-pointer hover:text-blue-600">Correspondence Templates</summary>
          <pre class="text-xs text-gray-600 mt-2 bg-gray-50 p-3 rounded overflow-x-auto whitespace-pre-wrap"><%= config.correspondence_templates_md %></pre>
        </details>
      <% end %>

      <% if config.risk_scoring_md.present? %>
        <details class="mb-3">
          <summary class="text-sm font-semibold text-gray-700 cursor-pointer hover:text-blue-600">Risk Scoring</summary>
          <pre class="text-xs text-gray-600 mt-2 bg-gray-50 p-3 rounded overflow-x-auto whitespace-pre-wrap"><%= config.risk_scoring_md %></pre>
        </details>
      <% end %>
    </div>
  <% end %>

  <%# ── Case Timeline ── %>
  <div class="border border-gray-300 rounded p-6 mb-6">
    <h2 class="text-lg font-bold mb-4 border-b border-gray-200 pb-2">Case Timeline</h2>

    <% sorted_notes = @case.case_notes.sort_by(&:created_at).reverse %>
    <% if sorted_notes.any? %>
      <div class="space-y-3">
        <% sorted_notes.each do |note| %>
          <div class="flex items-start gap-3 text-sm">
            <span class="text-gray-400 whitespace-nowrap font-mono text-xs"><%= note.created_at.strftime("%d %b %Y") %></span>
            <span class="whitespace-nowrap font-medium text-xs w-28 truncate"><%= timeline_author(note) %></span>
            <span><%= timeline_icon(note) %> <%= note.content %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-sm">No timeline entries yet.</p>
    <% end %>

    <div class="mt-4 pt-3 border-t border-gray-200">
      <%= link_to "Add note", new_case_case_note_path(@case), class: "text-sm bg-gray-800 text-white px-4 py-2 rounded hover:bg-gray-900" %>
    </div>
  </div>

  <%# ── Action links ── %>
  <div class="flex gap-4 text-sm">
    <%= link_to "Edit case", edit_case_path(@case), class: "text-blue-600 hover:underline" %>
    <%= link_to "Evidence requests", case_evidence_requests_path(@case), class: "text-blue-600 hover:underline" %>
  </div>
</div>
