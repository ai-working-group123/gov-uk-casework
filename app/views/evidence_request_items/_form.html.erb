<%= form_with(model: [@case, @evidence_request, evidence_request_item]) do |form| %>
  <% if evidence_request_item.errors.any? %>
    <div class="bg-red-50 text-red-500 px-4 py-3 rounded mb-4">
      <h2><%= pluralize(evidence_request_item.errors.count, "error") %> prohibited this item from being saved:</h2>
      <ul class="list-disc ml-5 mt-2">
        <% evidence_request_item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :evidence_id, "Evidence", class: "block font-medium mb-1" %>
    <%= form.collection_select :evidence_id, @case.evidences, :id, :evidence_type, { prompt: "Select evidence" }, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :policy_reference_id, "Policy Reference", class: "block font-medium mb-1" %>
    <%= form.collection_select :policy_reference_id, PolicyReference.all, :id, :title, { prompt: "None", include_blank: true }, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :submission_method, class: "block font-medium mb-1" %>
    <%= form.select :submission_method, EvidenceRequestItem.submission_methods.keys.map { |m| [m.humanize, m] }, { prompt: "Select method" }, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :reason, class: "block font-medium mb-1" %>
    <%= form.text_area :reason, rows: 3, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :status, class: "block font-medium mb-1" %>
    <%= form.select :status, EvidenceRequestItem.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div>
    <%= form.submit class: "bg-blue-600 text-white px-4 py-2 rounded cursor-pointer hover:bg-blue-700" %>
  </div>
<% end %>
