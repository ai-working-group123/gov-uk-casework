<%= form_with(model: [@case, @evidence_request, evidence_request_item]) do |form| %>
  <% if evidence_request_item.errors.any? %>
    <div class="notification-error">
      <h2><%= pluralize(evidence_request_item.errors.count, "error") %> prohibited this item from being saved:</h2>
      <ul class="list-disc ml-5 mt-2">
        <% evidence_request_item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :evidence_id, "Evidence", class: "form-label" %>
    <%= form.collection_select :evidence_id, @case.evidences, :id, :evidence_type, { prompt: "Select evidence" }, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :policy_reference_id, "Policy Reference", class: "form-label" %>
    <%= form.collection_select :policy_reference_id, PolicyReference.all, :id, :title, { prompt: "None", include_blank: true }, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :submission_method, class: "form-label" %>
    <%= form.select :submission_method, EvidenceRequestItem.submission_methods.keys.map { |m| [m.humanize, m] }, { prompt: "Select method" }, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :reason, class: "form-label" %>
    <%= form.text_area :reason, rows: 3, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :status, class: "form-label" %>
    <%= form.select :status, EvidenceRequestItem.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "w-full" %>
  </div>

  <div>
    <%= form.submit class: "btn-primary cursor-pointer" %>
  </div>
<% end %>
