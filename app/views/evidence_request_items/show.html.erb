<div>
  <% if notice.present? %><div class="notification-success"><%= notice %></div><% end %>

  <h1 class="text-3xl font-bold mb-6">Evidence Request Item</h1>

  <dl class="summary-list">
    <dt>Evidence</dt>
    <dd><%= @evidence_request_item.evidence.evidence_type.humanize %></dd>
    <dt>Submission Method</dt>
    <dd><%= @evidence_request_item.submission_method.humanize %></dd>
    <dt>Status</dt>
    <dd><%= @evidence_request_item.status.humanize %></dd>
    <dt>Reason</dt>
    <dd><%= @evidence_request_item.reason %></dd>
    <dt>Policy Reference</dt>
    <dd><%= @evidence_request_item.policy_reference&.title || "\u2014" %></dd>
    <dt>Received</dt>
    <dd><%= @evidence_request_item.received_at&.strftime("%d %b %Y %H:%M") || "\u2014" %></dd>
    <dt>Applicant Note</dt>
    <dd><%= @evidence_request_item.applicant_note || "\u2014" %></dd>
  </dl>

  <div class="flex gap-4">
    <%= link_to "Edit", edit_case_evidence_request_evidence_request_item_path(@case, @evidence_request, @evidence_request_item), class: "link" %>
    <%= link_to "Back to Items", case_evidence_request_evidence_request_items_path(@case, @evidence_request), class: "link-back" %>
  </div>
</div>
