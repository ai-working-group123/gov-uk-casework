<div class="max-w-4xl mx-auto py-8">
  <p class="text-green-600 mb-4"><%= notice %></p>

  <h1 class="text-2xl font-bold mb-4">Evidence Request Item</h1>

  <dl class="mb-6">
    <dt class="font-medium">Evidence</dt>
    <dd class="mb-2"><%= @evidence_request_item.evidence.evidence_type.humanize %></dd>
    <dt class="font-medium">Submission Method</dt>
    <dd class="mb-2"><%= @evidence_request_item.submission_method.humanize %></dd>
    <dt class="font-medium">Status</dt>
    <dd class="mb-2"><%= @evidence_request_item.status.humanize %></dd>
    <dt class="font-medium">Reason</dt>
    <dd class="mb-2"><%= @evidence_request_item.reason %></dd>
    <dt class="font-medium">Policy Reference</dt>
    <dd class="mb-2"><%= @evidence_request_item.policy_reference&.title || "\u2014" %></dd>
    <dt class="font-medium">Received</dt>
    <dd class="mb-2"><%= @evidence_request_item.received_at&.strftime("%d %b %Y %H:%M") || "\u2014" %></dd>
    <dt class="font-medium">Applicant Note</dt>
    <dd class="mb-2"><%= @evidence_request_item.applicant_note || "\u2014" %></dd>
  </dl>

  <div class="flex gap-4">
    <%= link_to "Edit", edit_case_evidence_request_evidence_request_item_path(@case, @evidence_request, @evidence_request_item), class: "text-blue-600 hover:underline" %>
    <%= link_to "Back to Items", case_evidence_request_evidence_request_items_path(@case, @evidence_request), class: "text-blue-600 hover:underline" %>
  </div>
</div>
