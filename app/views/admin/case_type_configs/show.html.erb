<% content_for(:title) { "#{@case_type_config.name} — Admin" } %>

<div class="max-w-4xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to Case Types", admin_case_type_configs_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <h2 class="text-2xl font-bold text-gray-900 mb-2"><%= @case_type_config.name %></h2>
  <p class="text-gray-600 mb-4"><%= @case_type_config.description %></p>

  <div class="flex gap-3">
    <%= link_to "View Review", review_admin_case_type_config_path(@case_type_config), class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors" %>
  </div>
</div>
