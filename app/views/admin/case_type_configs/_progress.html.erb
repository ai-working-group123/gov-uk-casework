<%# Render the step progress bar. Pass current_step: 1..6 %>
<% steps = [
  "Step 1: Scrape & Extract",
  "Step 2: Analyse",
  "Step 3: Clarifying Questions",
  "Step 4: Review",
  "Step 5: Improvement Suggestions",
  "Step 6: Finalise"
] %>

<div class="mb-8">
  <div class="flex items-center gap-4 text-sm flex-wrap">
    <% steps.each_with_index do |step, index| %>
      <% step_num = index + 1 %>
      <% if step_num < current_step %>
        <%# Completed step %>
        <span class="flex items-center gap-1.5 text-green-600">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
          <%= step %>
        </span>
      <% elsif step_num == current_step %>
        <%# Current step %>
        <span class="flex items-center gap-1.5 text-blue-600 font-semibold">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
          <%= step %>
        </span>
      <% else %>
        <%# Future step %>
        <span class="text-gray-400"><%= step %></span>
      <% end %>
    <% end %>
  </div>
</div>
