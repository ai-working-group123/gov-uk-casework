<div>
  <% if notice.present? %><div class="notification-success"><%= notice %></div><% end %>

  <h1 class="text-3xl font-bold mb-6">Case Note</h1>

  <dl class="summary-list">
    <dt>Type</dt>
    <dd><%= @case_note.note_type.humanize %></dd>
    <dt>Caseworker</dt>
    <dd><%= @case_note.caseworker&.name || "System" %></dd>
    <dt>Content</dt>
    <dd><%= @case_note.content %></dd>
    <dt>Visible to Applicant</dt>
    <dd><%= @case_note.visible_to_applicant ? "Yes" : "No" %></dd>
    <dt>Applicant Message</dt>
    <dd><%= @case_note.applicant_message || "\u2014" %></dd>
  </dl>

  <div class="flex gap-4">
    <%= link_to "Edit", edit_case_case_note_path(@case, @case_note), class: "link" %>
    <%= link_to "Back to Notes", case_case_notes_path(@case), class: "link-back" %>
  </div>
</div>
