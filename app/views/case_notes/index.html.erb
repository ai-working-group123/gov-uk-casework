<div >
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold mb-2">Notes for Case: <%= @case.reference %></h1>
    <%= link_to "New Note", new_case_case_note_path(@case), class: "btn-secondary" %>
  </div>

  <% if @case_notes.any? %>
    <% @case_notes.each do |note| %>
      <div class="border rounded p-4 mb-4">
        <div class="flex justify-between items-start mb-2">
          <span class="text-sm text-gray-500"><%= note.note_type.humanize %> &middot; <%= note.created_at.strftime("%d %b %Y %H:%M") %></span>
          <span class="text-sm text-gray-500"><%= note.caseworker&.name || "System" %></span>
        </div>
        <p class="mb-2"><%= note.content %></p>
        <div class="flex gap-2">
          <%= link_to "Show", case_case_note_path(@case, note), class: "text-blue-600 hover:underline text-sm" %>
          <%= link_to "Edit", edit_case_case_note_path(@case, note), class: "text-blue-600 hover:underline text-sm" %>
          <%= button_to "Delete", case_case_note_path(@case, note), method: :delete, class: "text-red-600 hover:underline text-sm", data: { turbo_confirm: "Are you sure?" } %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-gds-dark-grey">No notes yet.</p>
  <% end %>

  <div class="mt-4">
    <%= link_to "Back to Case", @case, class: "link" %>
  </div>
</div>
