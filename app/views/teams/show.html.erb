<div class="max-w-4xl mx-auto py-8">
  <p class="text-green-600 mb-4"><%= notice %></p>

  <h1 class="text-2xl font-bold mb-4"><%= @team.name %></h1>

  <dl class="mb-6">
    <dt class="font-medium">Leader ID</dt>
    <dd class="mb-2"><%= @team.leader_id || "\u2014" %></dd>
  </dl>

  <div class="flex gap-4">
    <%= link_to "Edit", edit_team_path(@team), class: "text-blue-600 hover:underline" %>
    <%= link_to "Back to Teams", teams_path, class: "text-blue-600 hover:underline" %>
  </div>
</div>
