<%= form_with(model: team) do |form| %>
  <% if team.errors.any? %>
    <div class="notification-error">
      <h2><%= pluralize(team.errors.count, "error") %> prohibited this team from being saved:</h2>
      <ul class="list-disc ml-5 mt-2">
        <% team.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :leader_id, class: "form-label" %>
    <%= form.text_field :leader_id, class: "w-full" %>
  </div>

  <div>
    <%= form.submit class: "btn-primary cursor-pointer" %>
  </div>
<% end %>
