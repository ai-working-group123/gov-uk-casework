<div >
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold mb-2">Teams</h1>
    <%= link_to "New Team", new_team_path, class: "btn-secondary" %>
  </div>

  <% if @teams.any? %>
    <table class="gds-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Leader ID</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @teams.each do |team| %>
          <tr>
            <td><%= team.name %></td>
            <td><%= team.leader_id %></td>
            <td class="flex gap-3">
              <%= link_to "Show", team, class: "link" %>
              <%= link_to "Edit", edit_team_path(team), class: "link" %>
              <%= button_to "Delete", team, method: :delete, class: "link text-gds-red", data: { turbo_confirm: "Are you sure?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gds-dark-grey">No teams yet.</p>
  <% end %>
</div>
