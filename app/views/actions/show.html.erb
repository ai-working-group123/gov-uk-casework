<div>
  <% if notice.present? %><div class="notification-success"><%= notice %></div><% end %>

  <h1 class="text-3xl font-bold mb-6"><%= @action.title %></h1>

  <dl class="summary-list">
    <dt>Type</dt>
    <dd><%= @action.action_type.humanize %></dd>
    <dt>Status</dt>
    <dd><%= @action.status.humanize %></dd>
    <dt>Description</dt>
    <dd><%= @action.description || "\u2014" %></dd>
    <dt>Due Date</dt>
    <dd><%= @action.due_date&.strftime("%d %b %Y %H:%M") || "\u2014" %></dd>
    <dt>Completed</dt>
    <dd><%= @action.completed_at&.strftime("%d %b %Y %H:%M") || "\u2014" %></dd>
    <dt>Blocked By</dt>
    <dd><%= @action.blocked_by || "\u2014" %></dd>
    <dt>Policy Reference</dt>
    <dd><%= @action.policy_reference&.title || "\u2014" %></dd>
    <dt>Caseworker Guidance</dt>
    <dd><%= @action.caseworker_guidance || "\u2014" %></dd>
  </dl>

  <div class="flex gap-4 mb-8">
    <%= link_to "Edit", edit_case_action_path(@case, @action), class: "link" %>
    <%= link_to "Correspondences", case_action_correspondences_path(@case, @action), class: "link" %>
    <%= link_to "Back to Actions", case_actions_path(@case), class: "link-back" %>
  </div>
</div>
