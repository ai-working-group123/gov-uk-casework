<div >
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold mb-2">Actions for Case: <%= @case.reference %></h1>
    <%= link_to "New Action", new_case_action_path(@case), class: "btn-secondary" %>
  </div>

  <% if @actions.any? %>
    <table class="gds-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Type</th>
          <th>Status</th>
          <th>Due</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @actions.each do |action| %>
          <tr>
            <td><%= action.title %></td>
            <td><%= action.action_type.humanize %></td>
            <td><%= action.status.humanize %></td>
            <td><%= action.due_date&.strftime("%d %b %Y") || "\u2014" %></td>
            <td class="flex gap-3">
              <%= link_to "Show", case_action_path(@case, action), class: "link" %>
              <%= link_to "Edit", edit_case_action_path(@case, action), class: "link" %>
              <%= button_to "Delete", case_action_path(@case, action), method: :delete, class: "link text-gds-red", data: { turbo_confirm: "Are you sure?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gds-dark-grey">No actions yet.</p>
  <% end %>

  <div class="mt-4">
    <%= link_to "Back to Case", @case, class: "link" %>
  </div>
</div>
