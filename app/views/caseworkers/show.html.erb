<div>
  <% if notice.present? %><div class="notification-success"><%= notice %></div><% end %>

  <h1 class="text-3xl font-bold mb-6"><%= @caseworker.name %></h1>

  <dl class="summary-list">
    <dt>Email</dt>
    <dd><%= @caseworker.email %></dd>
    <dt>Role</dt>
    <dd><%= @caseworker.role.humanize %></dd>
    <dt>Team</dt>
    <dd><%= @caseworker.team.name %></dd>
    <dt>Capacity</dt>
    <dd><%= @caseworker.capacity %></dd>
  </dl>

  <div class="flex gap-4">
    <%= link_to "Edit", edit_caseworker_path(@caseworker), class: "link" %>
    <%= link_to "Back to Caseworkers", caseworkers_path, class: "link-back" %>
  </div>
</div>
