<%= form_with(model: caseworker) do |form| %>
  <% if caseworker.errors.any? %>
    <div class="bg-red-50 text-red-500 px-4 py-3 rounded mb-4">
      <h2><%= pluralize(caseworker.errors.count, "error") %> prohibited this caseworker from being saved:</h2>
      <ul class="list-disc ml-5 mt-2">
        <% caseworker.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :name, class: "block font-medium mb-1" %>
    <%= form.text_field :name, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :email, class: "block font-medium mb-1" %>
    <%= form.email_field :email, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :role, class: "block font-medium mb-1" %>
    <%= form.select :role, Caseworker.roles.keys.map { |r| [r.humanize, r] }, {}, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :team_id, class: "block font-medium mb-1" %>
    <%= form.collection_select :team_id, Team.all, :id, :name, { prompt: "Select a team" }, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :capacity, class: "block font-medium mb-1" %>
    <%= form.number_field :capacity, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div>
    <%= form.submit class: "bg-blue-600 text-white px-4 py-2 rounded cursor-pointer hover:bg-blue-700" %>
  </div>
<% end %>
