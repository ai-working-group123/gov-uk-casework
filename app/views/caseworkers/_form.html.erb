<%= form_with(model: caseworker) do |form| %>
  <% if caseworker.errors.any? %>
    <div class="notification-error">
      <h2><%= pluralize(caseworker.errors.count, "error") %> prohibited this caseworker from being saved:</h2>
      <ul class="list-disc ml-5 mt-2">
        <% caseworker.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :email, class: "form-label" %>
    <%= form.email_field :email, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :role, class: "form-label" %>
    <%= form.select :role, Caseworker.roles.keys.map { |r| [r.humanize, r] }, {}, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :team_id, class: "form-label" %>
    <%= form.collection_select :team_id, Team.all, :id, :name, { prompt: "Select a team" }, class: "w-full" %>
  </div>

  <div class="form-group">
    <%= form.label :capacity, class: "form-label" %>
    <%= form.number_field :capacity, class: "w-full" %>
  </div>

  <div>
    <%= form.submit class: "btn-primary cursor-pointer" %>
  </div>
<% end %>
