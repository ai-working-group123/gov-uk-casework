<div >
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold mb-2">Caseworkers</h1>
    <%= link_to "New Caseworker", new_caseworker_path, class: "btn-secondary" %>
  </div>

  <% if @caseworkers.any? %>
    <table class="gds-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Team</th>
          <th>Capacity</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @caseworkers.each do |caseworker| %>
          <tr>
            <td><%= caseworker.name %></td>
            <td><%= caseworker.email %></td>
            <td><%= caseworker.role.humanize %></td>
            <td><%= caseworker.team.name %></td>
            <td><%= caseworker.capacity %></td>
            <td class="flex gap-3">
              <%= link_to "Show", caseworker, class: "link" %>
              <%= link_to "Edit", edit_caseworker_path(caseworker), class: "link" %>
              <%= button_to "Delete", caseworker, method: :delete, class: "link text-gds-red", data: { turbo_confirm: "Are you sure?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gds-dark-grey">No caseworkers yet.</p>
  <% end %>
</div>
