<div>
  <% if notice.present? %><div class="notification-success"><%= notice %></div><% end %>

  <h1 class="text-3xl font-bold mb-6"><%= @policy_reference.title %></h1>

  <dl class="summary-list">
    <dt>Code</dt>
    <dd><%= @policy_reference.code %></dd>
    <dt>Parent Code</dt>
    <dd><%= @policy_reference.parent_code || "\u2014" %></dd>
    <dt>Policy Area</dt>
    <dd><%= @policy_reference.policy_area %></dd>
    <dt>Case Types</dt>
    <dd><%= @policy_reference.case_types %></dd>
    <dt>Summary</dt>
    <dd><%= @policy_reference.summary %></dd>
    <dt>Criteria</dt>
    <dd><%= @policy_reference.criteria %></dd>
    <dt>GOV.UK URL</dt>
    <dd><% if @policy_reference.govuk_url.present? %>
      <% url = URI.parse(@policy_reference.govuk_url) rescue nil %>
      <% if url&.host&.end_with?("gov.uk") && url&.scheme == "https" %>
        <%= link_to url.to_s, url.to_s %>
      <% else %>
        <%= @policy_reference.govuk_url %>
      <% end %>
    <% end %></dd>
  </dl>

  <div class="flex gap-4">
    <%= link_to "Edit", edit_policy_reference_path(@policy_reference), class: "link" %>
    <%= link_to "Back to Policy References", policy_references_path, class: "link-back" %>
  </div>
</div>
