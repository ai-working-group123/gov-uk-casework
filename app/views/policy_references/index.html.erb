<div >
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold mb-2">Policy References</h1>
    <%= link_to "New Policy Reference", new_policy_reference_path, class: "btn-secondary" %>
  </div>

  <% if @policy_references.any? %>
    <table class="gds-table">
      <thead>
        <tr>
          <th>Code</th>
          <th>Title</th>
          <th>Policy Area</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @policy_references.each do |pr| %>
          <tr>
            <td><%= pr.code %></td>
            <td><%= pr.title %></td>
            <td><%= pr.policy_area %></td>
            <td class="flex gap-3">
              <%= link_to "Show", pr, class: "link" %>
              <%= link_to "Edit", edit_policy_reference_path(pr), class: "link" %>
              <%= button_to "Delete", pr, method: :delete, class: "link text-gds-red", data: { turbo_confirm: "Are you sure?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gds-dark-grey">No policy references yet.</p>
  <% end %>
</div>
