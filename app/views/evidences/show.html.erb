<div class="max-w-4xl mx-auto py-8">
  <p class="text-green-600 mb-4"><%= notice %></p>

  <h1 class="text-2xl font-bold mb-4"><%= @evidence.evidence_type.humanize %></h1>

  <dl class="mb-6">
    <dt class="font-medium">Status</dt>
    <dd class="mb-2"><%= @evidence.status.humanize %></dd>
    <dt class="font-medium">Received</dt>
    <dd class="mb-2"><%= @evidence.received_at&.strftime("%d %b %Y %H:%M") || "\u2014" %></dd>
    <dt class="font-medium">Reviewed</dt>
    <dd class="mb-2"><%= @evidence.reviewed_at&.strftime("%d %b %Y %H:%M") || "\u2014" %></dd>
    <dt class="font-medium">Required By</dt>
    <dd class="mb-2"><%= @evidence.required_by&.strftime("%d %b %Y") || "\u2014" %></dd>
    <dt class="font-medium">Notes</dt>
    <dd class="mb-2"><%= @evidence.notes || "\u2014" %></dd>
    <dt class="font-medium">Policy Reference</dt>
    <dd class="mb-2"><%= @evidence.policy_reference&.title || "\u2014" %></dd>
  </dl>

  <div class="flex gap-4">
    <%= link_to "Edit", edit_case_evidence_path(@case, @evidence), class: "text-blue-600 hover:underline" %>
    <%= link_to "Back to Evidences", case_evidences_path(@case), class: "text-blue-600 hover:underline" %>
  </div>
</div>
