<div>
  <% if notice.present? %><div class="notification-success"><%= notice %></div><% end %>

  <h1 class="text-3xl font-bold mb-6"><%= @evidence.evidence_type.humanize %></h1>

  <dl class="summary-list">
    <dt>Status</dt>
    <dd><%= @evidence.status.humanize %></dd>
    <dt>Received</dt>
    <dd><%= @evidence.received_at&.strftime("%d %b %Y %H:%M") || "\u2014" %></dd>
    <dt>Reviewed</dt>
    <dd><%= @evidence.reviewed_at&.strftime("%d %b %Y %H:%M") || "\u2014" %></dd>
    <dt>Required By</dt>
    <dd><%= @evidence.required_by&.strftime("%d %b %Y") || "\u2014" %></dd>
    <dt>Notes</dt>
    <dd><%= @evidence.notes || "\u2014" %></dd>
    <dt>Policy Reference</dt>
    <dd><%= @evidence.policy_reference&.title || "\u2014" %></dd>
  </dl>

  <div class="flex gap-4">
    <%= link_to "Edit", edit_case_evidence_path(@case, @evidence), class: "link" %>
    <%= link_to "Back to Evidences", case_evidences_path(@case), class: "link-back" %>
  </div>
</div>
