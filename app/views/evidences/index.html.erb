<div >
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold mb-2">Evidences for Case: <%= @case.reference %></h1>
    <%= link_to "New Evidence", new_case_evidence_path(@case), class: "btn-secondary" %>
  </div>

  <% if @evidences.any? %>
    <table class="gds-table">
      <thead>
        <tr>
          <th>Type</th>
          <th>Status</th>
          <th>Received</th>
          <th>Policy Ref</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @evidences.each do |evidence| %>
          <tr>
            <td><%= evidence.evidence_type.humanize %></td>
            <td><%= evidence.status.humanize %></td>
            <td><%= evidence.received_at&.strftime("%d %b %Y") || "\u2014" %></td>
            <td><%= evidence.policy_reference&.title || "\u2014" %></td>
            <td class="flex gap-3">
              <%= link_to "Show", case_evidence_path(@case, evidence), class: "link" %>
              <%= link_to "Edit", edit_case_evidence_path(@case, evidence), class: "link" %>
              <%= button_to "Delete", case_evidence_path(@case, evidence), method: :delete, class: "link text-gds-red", data: { turbo_confirm: "Are you sure?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gds-dark-grey">No evidence yet.</p>
  <% end %>

  <div class="mt-4">
    <%= link_to "Back to Case", @case, class: "link" %>
  </div>
</div>
