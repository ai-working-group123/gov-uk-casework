<div class="max-w-4xl mx-auto py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Evidences for Case: <%= @case.reference %></h1>
    <%= link_to "New Evidence", new_case_evidence_path(@case), class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
  </div>

  <% if @evidences.any? %>
    <table class="min-w-full border">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left">Type</th>
          <th class="px-4 py-2 text-left">Status</th>
          <th class="px-4 py-2 text-left">Received</th>
          <th class="px-4 py-2 text-left">Policy Ref</th>
          <th class="px-4 py-2 text-left">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @evidences.each do |evidence| %>
          <tr class="border-t">
            <td class="px-4 py-2"><%= evidence.evidence_type.humanize %></td>
            <td class="px-4 py-2"><%= evidence.status.humanize %></td>
            <td class="px-4 py-2"><%= evidence.received_at&.strftime("%d %b %Y") || "\u2014" %></td>
            <td class="px-4 py-2"><%= evidence.policy_reference&.title || "\u2014" %></td>
            <td class="px-4 py-2 flex gap-2">
              <%= link_to "Show", case_evidence_path(@case, evidence), class: "text-blue-600 hover:underline" %>
              <%= link_to "Edit", edit_case_evidence_path(@case, evidence), class: "text-blue-600 hover:underline" %>
              <%= button_to "Delete", case_evidence_path(@case, evidence), method: :delete, class: "text-red-600 hover:underline", data: { turbo_confirm: "Are you sure?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-500">No evidence yet.</p>
  <% end %>

  <div class="mt-4">
    <%= link_to "Back to Case", @case, class: "text-blue-600 hover:underline" %>
  </div>
</div>
