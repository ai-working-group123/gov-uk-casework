<div class="py-8">
  <h1 class="text-4xl font-bold mb-2">Home Office Casework System</h1>
  <p class="text-lg text-gds-dark-grey mb-10">Select how you would like to proceed.</p>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-0 md:gap-8">
    <a href="<%= cases_path %>" class="block py-6 border-t-4 border-gds-blue hover:bg-gds-light-grey transition-colors">
      <h2 class="text-xl font-bold mb-2">Admin Portal</h2>
      <p class="text-gds-dark-grey text-sm">Manage cases, evidence, actions and correspondence as a caseworker.</p>
    </a>

    <a href="<%= public_lookup_path %>" class="block py-6 border-t-4 border-gds-green hover:bg-gds-light-grey transition-colors">
      <h2 class="text-xl font-bold mb-2">Public Portal</h2>
      <p class="text-gds-dark-grey text-sm">Look up the status of your application using your case reference number.</p>
    </a>

    <a href="<%= case_type_configs_path %>" class="block py-6 border-t-4 border-gds-purple hover:bg-gds-light-grey transition-colors">
      <h2 class="text-xl font-bold mb-2">Case Type Builder</h2>
      <p class="text-gds-dark-grey text-sm">Create and manage AI-generated case type configurations.</p>
    </a>
  </div>
</div>
