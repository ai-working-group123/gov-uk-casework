<div class="max-w-2xl mx-auto py-16 text-center">
  <h1 class="text-4xl font-bold mb-4">Home Office Casework System</h1>
  <p class="text-gray-600 mb-12">Select how you would like to proceed.</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <a href="<%= cases_path %>" class="block border rounded-lg p-8 hover:shadow-lg transition-shadow">
      <h2 class="text-2xl font-semibold mb-2">Admin Portal</h2>
      <p class="text-gray-500">Manage cases, evidence, actions and correspondence as a caseworker.</p>
    </a>

    <a href="<%= public_lookup_path %>" class="block border rounded-lg p-8 hover:shadow-lg transition-shadow">
      <h2 class="text-2xl font-semibold mb-2">Public Portal</h2>
      <p class="text-gray-500">Look up the status of your application using your case reference number.</p>
    </a>
  </div>
</div>
