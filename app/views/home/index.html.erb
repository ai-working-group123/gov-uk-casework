<div class="max-w-[640px]">
  <h1 class="text-3xl font-bold mb-2">Case Management Service</h1>
  <p class="text-lg text-gds-dark-grey mb-8">Internal tools for caseworkers and administrators.</p>

  <div class="gds-section">
    <h2 class="gds-section-title">Casework</h2>
    <p class="text-gds-dark-grey mb-4">View, manage, and progress active cases. Track evidence, actions, and correspondence.</p>
    <%= link_to "Go to cases", cases_path, class: "btn-primary" %>
  </div>

  <div class="gds-section">
    <h2 class="gds-section-title">Case Type Builder</h2>
    <p class="text-gds-dark-grey mb-4">Create and manage AI-generated case type configurations that define how cases are processed.</p>
    <%= link_to "Manage case types", case_type_configs_path, class: "btn-secondary" %>
  </div>

  <div class="gds-section">
    <h2 class="gds-section-title">Public status lookup</h2>
    <p class="text-gds-dark-grey mb-4">Applicants can check the status of their application using a case reference number.</p>
    <%= link_to "View public portal", public_lookup_path, class: "btn-secondary" %>
  </div>
</div>
